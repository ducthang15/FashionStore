@model IEnumerable<FashionStore.Repository.Models.News>
@{
    ViewData["Title"] = "Blog";
    ViewData["MetaDescription"] = "Explore the UNLIM TAILOR Blog: Expert insights on men’s style, how to choose suits, tuxedos, and accessories. Tips to become a refined gentleman. Read now!";
}
<div class="blog-page">
    <div class="position-relative text-white">
        <picture>
            <source media="(min-width: 992px)"
                    srcset="/image/poster-index-2233.png">
            <source media="(min-width: 576px)"
                    srcset="/image/poster-index-2233.png">
            <img src="/image/poster-index-2233.png"
                 class="img-fluid w-100"
                 alt="Bespoke Tailoring">
        </picture>
        <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50"></div>
        <div class="position-absolute top-50 start-50 translate-middle text-center px-4 d-none d-md-block">
            <h1 class="fs-3">
                A Craftsmanship Story
            </h1>
            <h3 class="text-uppercase small">
                UNLIM Tailor Bespoke Tailoring
            </h3>
            <p class="mx-auto" style="max-width: 850px;">
                Bespoke tailoring is our most premium offering, allowing you to create your own unique custom pieces —
                from precise measurements to cloth choice to styling features.

            </p>
            <h5>
                How a Garment is Born
            </h5>
            <p class="fst-italic">
                Time, skill, and creativity: these are the essential elements that transform fabric into a finished garment.
            </p>
        </div>
    </div>
    <div class="container mt-5 mb-5">
        <div class="row gx-lg-5">

            <div class="col-lg-8 mb-4">
                <h2>
                    Our Articles
                </h2>

                @if (Model != null && Model.Any())
                {
                    <div class="row g-4">
                        @foreach (var item in Model)
                        {
                            <div class="col-12">
                                <div class="card blog-card h-100 overflow-hidden">
                                    <div class="row g-0 h-100">
                                        <div class="col-md-5 col-lg-4 blog-img-wrapper">
                                            <a asp-action="Details" asp-route-slug="@item.Slug" class="d-block h-100">
                                                <img src="@item.ImageUrl" class="blog-img" alt="@item.Title">
                                            </a>
                                        </div>
                                        <div class="col-md-7 col-lg-8">
                                            <div class="card-body d-flex flex-column h-100 p-4">
                                                <p class="text-muted small mb-2 fw-medium">
                                                    <i class="ri-calendar-line text-primary align-middle me-1"></i>
                                                    @(item.CreatedAt?.ToString("dd/MM/yyyy") ?? "Đang cập nhật")
                                                </p>

                                                <h4 class="card-title fw-bold mb-3">
                                                    <a asp-action="Details" asp-route-slug="@item.Slug" class="text-decoration-none text-dark text-clamp-2 title-hover">
                                                        @item.Title
                                                    </a>
                                                </h4>
                                                <p class="card-text text-muted text-clamp-3 mb-4">
                                                    @item.Summary
                                                </p>

                                                <div class="mt-auto">
                                                    <a asp-action="Details" asp-route-slug="@item.Slug" class="btn btn-outline-dark btn-sm px-4">
                                                        Read more  <i class="ri-arrow-right-double-line"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 bg-light rounded-4 border">
                        <i class="ri-article-line fs-1 text-muted mb-3 d-block"></i>
                        <h5 class="text-muted fw-normal">Hiện tại chưa có bài viết nào.</h5>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <div class="sidebar-widget sticky-lg-top" style="top: 2rem;">
                    <h3>
                        Related News
                    </h3>

                    <div class="d-flex flex-column gap-1">
                        @if (ViewBag.FeaturedNews != null)
                        {
                            foreach (var item in ViewBag.FeaturedNews)
                            {
                                <a asp-action="Details" asp-route-slug="@item.Slug" class="related-news-item d-flex text-decoration-none">
                                    <img src="@item.ImageUrl" class="related-img shadow-sm flex-shrink-0" alt="@item.Title" />
                                    <div class="ms-3">
                                        <h6 class="mb-1 text-clamp-2 title-hover lh-base text-white">
                                            @item.Title
                                        </h6>
                                        <p class="text-white detail-read">
                                            Read more <i class="ri-arrow-right-s-line align-middle"></i>
                                        </p>
                                    </div>
                                </a>
                            }
                        }
                        else
                        {
                            <p class="text-muted small italic">NOT RELATED NEWS</p>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
    <nav class="mt-4">
        <ul class="pagination custom-pagination justify-content-center">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-id="@ViewBag.CurrentCategoryId">
                    &lsaquo;
                </a>
            </li>
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-id="@ViewBag.CurrentCategoryId">
                        @i
                    </a>
                </li>
            }
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-id="@ViewBag.CurrentCategoryId">
                    &rsaquo;
                </a>
            </li>
        </ul>
    </nav>
</div>