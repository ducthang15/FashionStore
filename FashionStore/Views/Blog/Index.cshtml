@model IEnumerable<FashionStore.Repository.Models.News>
@{
    ViewData["Title"] = "Blog";
    ViewData["MetaDescription"] = "Explore the UNLIM TAILOR Blog: Expert insights on men’s style, how to choose suits, tuxedos, and accessories. Tips to become a refined gentleman. Read now!";
}
<div class="blog-page">
    <div class="position-relative text-white">
        <picture>
            <source media="(min-width: 992px)"
                    srcset="/image/blog_unlimvest.jpg">
            <source media="(min-width: 576px)"
                    srcset="/image/blog_unlimvest.jpg">
            <img src="/image/blog_unlimvest.jpg"
                 class="img-fluid w-100"
                 alt="Bespoke Tailoring">
        </picture>
        <div class="position-absolute top-50 start-50 translate-middle text-center px-4 d-none d-md-block">
            <h1 class="fs-3">
                A Craftsmanship Story
            </h1>
            <h3 class="text-uppercase small">
                UNLIM Tailor Bespoke Tailoring
            </h3>
            <p class="mx-auto" style="max-width: 850px;">
                Bespoke tailoring is our most premium offering, allowing you to create your own unique custom pieces —
                from precise measurements to cloth choice to styling features.
            </p>
        </div>
        <h2 class="position-absolute top-50 start-50 translate-middle text-center px-4 d-block d-md-none">Blog Tailor</h2>
    </div>
    <div class="container mt-3">
        <div class="row gx-lg-5">
            <div class="col-lg-8">
                @if (Model != null && Model.Any())
                {
                    <div class="row g-3">
                        @foreach (var item in Model)
                        {
                            <div class="col-12">
                                <div class="card blog-card h-100 overflow-hidden">
                                    <div class="row h-100">
                                        <div class="col-md-6 col-lg-5 blog-img-wrapper">
                                            <a asp-action="Details" asp-route-slug="@item.Slug" class="d-block h-100">
                                                <img src="@item.ImageUrl" class="blog-img" alt="@item.Title">
                                            </a>
                                        </div>
                                        <div class="col-md-6 col-lg-7">
                                            <div class="card-body d-flex flex-column h-100">
                                                <div class="d-flex align-items-center gap-3">
                                                    <p class="text-muted small mb-0">
                                                        <i class="ri-calendar-line align-middle me-1 text-muted"></i>
                                                        @(item.CreatedAt?.ToString("dd/MM/yyyy") ?? "Đang cập nhật")
                                                    </p>
                                                    <span class="text-muted small">
                                                        <i class="fa-regular fa-eye me-1 text-muted"></i>
                                                        @item.ViewCount view
                                                    </span>
                                                </div>
                                                <h6 class="card-title text-uppercase">
                                                    <a asp-action="Details" asp-route-slug="@item.Slug" class="text-decoration-none text-dark title-hover">
                                                        @item.Title
                                                    </a>
                                                </h6>
                                                <p class="title-hover-p card-text text-muted text-clamp-3 mb-4">
                                                    @item.Summary
                                                </p>

                                                <div class="mt-auto">
                                                    <a asp-action="Details" asp-route-slug="@item.Slug" class="btn btn-outline-dark btn-sm px-4">
                                                        Read more  <i class="ri-arrow-right-double-line"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 bg-light rounded-4 border">
                        <i class="ri-article-line fs-1 text-muted mb-3 d-block"></i>
                        <h5 class="text-muted fw-normal">No article</h5>
                    </div>
                }
                <nav class="mt-4">
                    <ul class="pagination custom-pagination justify-content-center">
                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-id="@ViewBag.CurrentCategoryId">
                                &lsaquo;
                            </a>
                        </li>
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-id="@ViewBag.CurrentCategoryId">
                                    @i
                                </a>
                            </li>
                        }
                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-id="@ViewBag.CurrentCategoryId">
                                &rsaquo;
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>

            <div class="col-lg-4">
                <div class="sidebar-widget title-hover">
                    <h3>
                        Related News
                    </h3>
                    <div class="d-flex flex-column gap-1">
                        @if (ViewBag.FeaturedNews != null)
                        {
                            foreach (var item in ViewBag.FeaturedNews)
                            {
                                <a asp-action="Details" asp-route-slug="@item.Slug" class="related-news-item d-flex text-decoration-none">
                                    <img src="@item.ImageUrl" class="related-img shadow-sm flex-shrink-0" alt="@item.Title" />
                                    <div class="ms-3">
                                        <h6 class="text-clamp-2 text-uppercase title-hover text-white">
                                            @item.Title
                                        </h6>
                                        <p class="text-warning detail-read">
                                            Read more <i class="ri-arrow-right-s-line align-middle"></i>
                                        </p>
                                    </div>
                                </a>
                            }
                        }
                        else
                        {
                            <p class="text-muted small italic">NOT RELATED NEWS</p>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<a href="https://www.facebook.com/MAYDOSUITCAOCAP" target="_blank" class="messenger-circle d-md-none">
    <i class="fa-brands fa-facebook-messenger"></i>
</a>
<a href="tel:0989473579" class="call-circle d-md-none">
    <i class="fa-solid fa-phone"></i>
</a>
<a href="https://zalo.me/0989473579" target="_blank" class="zalo-circle d-md-none">
    <img src="https://upload.wikimedia.org/wikipedia/commons/9/91/Icon_of_Zalo.svg" alt="Zalo" />
</a>
