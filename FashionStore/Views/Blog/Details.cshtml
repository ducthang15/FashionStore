@using FashionStore.Repository.Models
@model FashionStore.Repository.Models.News
@{
    ViewData["Title"] = Model.Title;
}
<picture>
    <source media="(min-width: 992px)"
            srcset="/image/banner-main-project-2-(2).png">
    <source media="(min-width: 576px)"
            srcset="/image/banner-main-project-2-(2).png">
    <img src="/image/banner-main-project-2-(2).png"
         class="img-fluid w-100"
         alt="Bespoke Tailoring">
</picture>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <img src="@Model.ImageUrl" class="img-fluid w-100 rounded mb-4" style="max-height: 400px; object-fit: cover;">
            <h1 class="fw-bold mb-3 text-dark">@Model.Title</h1>
            <h5 class="mt-3 text-dark">@Model.Summary</h5>
            <p class="text-muted"><i class="fa-regular fa-clock"></i> @Model.CreatedAt?.ToString("dd/MM/yyyy")</p>
            <hr>
            <div class="blog-content fs-5 text-dark" style="line-height: 1.8;">
                @Html.Raw(Model.Content?.Replace("\n", "<br>"))
            </div>
            <div class="border-top">

            </div>
            <div class="float-end mt-4 mb-4">
                <a asp-action="Index" class="btn btn-secondary"> Back</a>
            </div>
        </div>
        <div class="mb-5">
            <h5 class="fw-bold mb-3 text-dark">SUIT PRODUCTS</h5>

            <div class="d-flex flex-wrap gap-3">
                @if (ViewBag.SuitProducts != null)
                {
                    foreach (var item in ViewBag.SuitProducts)
                    {
                        <a asp-controller="Home" asp-action="Details" asp-route-slug="@item.Slug" class="text-decoration-none text-dark" style="width:120px;">
                            <div class="card border-0 shadow-sm h-100">
                                <img src="@item.ImageUrl" class="card-img-top" style="height:120px; object-fit:cover;" />
                                <div class="card-body p-2 text-center">
                                    <p class="small mb-0 fw-semibold">
                                        @item.ProductName
                                    </p>
                                </div>
                            </div>

                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>