@using FashionStore.Repository.Models
@model FashionStore.Repository.Models.News
@{
    ViewData["Title"] = Model.Title;
}
<picture>
    <source media="(min-width: 992px)"
            srcset="/image/banner-main-project-2-(2).png">
    <source media="(min-width: 576px)"
            srcset="/image/banner-main-project-2-(2).png">
    <img src="/image/banner-main-project-2-(2).png"
         class="img-fluid w-100"
         alt="@Model.Title">
</picture>
@section Styles {

    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css" />
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css" />
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <img src="@Model.ImageUrl" class="img-fluid w-100 rounded mb-4" style="max-height: 400px; object-fit: cover;">
            <h1 class="fw-bold mb-3 text-dark">@Model.Title</h1>
            <h5 class="mt-3 text-dark">@Model.Summary</h5>
            <p class="text-muted"><i class="fa-regular fa-clock"></i> @Model.CreatedAt?.ToString("dd/MM/yyyy")</p>
            <hr>
            <div class="blog-content text-dark">
                @Html.Raw(Model.Content)
            </div>
            <div class="border-top">
                <div class="related-post mt-2">

                    <h4 class="fw-bold mb-3 text-dark">Related Articles</h4>

                    <div class="row">
                        @if (ViewBag.Related != null)
                        {
                            foreach (var item in ViewBag.Related)
                            {
                                <div class="col-md-6 mb-3">
                                    <a href="/blog/details/@item.Slug" class="text-decoration-none text-dark">
                                        <div class="d-flex gap-3">
                                            <img src="@item.ImageUrl" style="width:100px; height:70px; object-fit:cover;" class="rounded" />
                                            <div>
                                                <h6 class="mb-1">@item.Title</h6>
                                                <small class="text-muted">
                                                    @(item.CreatedAt?.ToString("dd/MM/yyyy"))
                                                </small>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                        }
                    </div>

                </div>
            </div>
            <div class="float-end mt-4 mb-2">
                <a asp-action="Index" class="btn btn-secondary"> Back</a>
            </div>
        </div>
        <div class="col-md-8">
            <h4 class="fw-bold mb-3 text-dark">SUIT PRODUCTS</h4>

            <div class="suit-slider">
                @if (ViewBag.SuitProducts != null)
                {
                    foreach (var item in ViewBag.SuitProducts)
                    {
                        <div class="px-2">
                            <a asp-controller="Home" asp-action="Details" asp-route-slug="@item.Slug" class="text-decoration-none text-dark d-block">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="ratio ratio-1x1">
                                        <img src="@item.ImageUrl" class="card-img-top rounded-top" style="object-fit:cover;" />
                                    </div>
                                    <div class="card-body p-2 text-center">
                                        <p class="small mb-0 fw-semibold text-truncate-2">
                                            @item.ProductName
                                        </p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
    <script>
        $(function () {
               $('.suit-slider').slick({
                   infinite: true,
                   slidesToShow: 4,
                   slidesToScroll: 1,
                   arrows: true,
                   autoplay: true,
                   autoplaySpeed: 3000,
                   responsive: [
                       {
                           breakpoint: 992,
                           settings: {
                               slidesToShow: 3,
                               slidesToScroll: 1,
                               arrows: true
                           }
                       },
                       {
                           breakpoint: 576,
                           settings: {
                               slidesToShow: 3,
                               slidesToScroll: 3,
                               arrows: false,
                               dots: true,
                               centerMode: false
                           }
                       }
                   ]
               });
           });
    </script>
}
