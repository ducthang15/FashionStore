@model IEnumerable<FashionStore.Repository.Models.News>
@{
    ViewData["Title"] = ViewBag.CategoryName;
    ViewData["MetaDescription"] = "Unlim Tailor's premium uniform tailoring process: From design consultation and on-site measurements to lifetime warranty. Elevate your company's brand identity.";

}
<h1 class="container text-dark text-uppercase fs-2 text-center mt-2">
    @ViewBag.CategoryName
</h1>
<picture>
    <source media="(min-width: 992px)"
            srcset="/image/banner-main-project-2-(2).png">
    <source media="(min-width: 576px)"
            srcset="/image/banner-main-project-2-(2).png">
    <img src="/image/banner-main-project-2-(2).png"
         class="img-fluid w-100"
         alt="Bespoke Tailoring">
</picture>
<div class="container mt-3">

    @{
        int index = 0;
    }

    @foreach (var item in Model)
    {
        var isEven = index % 2 == 0;
        <div class="row align-items-center mb-5">
            <div class="col-lg-6 col-md-6 col-12 @(isEven ? "order-md-1" : "order-md-2") order-2">
                <div class="pe-lg-5">
                    <h4 class="fs-5">
                        <a asp-action="Details" asp-route-slug="@item.Slug"
                           class="text-decoration-none text-dark">
                            @item.Title
                        </a>
                    </h4>
                    <p class="text-muted">
                        @item.Summary
                    </p>
                    <a asp-action="Details" asp-route-slug="@item.Slug"
                       class="see-more-link text-decoration-none text-dark fw-semibold">
                        See more →
                    </a>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12 @(isEven ? "order-md-2" : "order-md-1") order-1 mb-3 mb-md-0">
                <div class="ratio ratio-16x9">
                    <img src="@item.ImageUrl"
                         class="img-fluid"
                         style="object-fit: cover;"
                         alt="@item.Title">
                </div>
            </div>
        </div>
        index++;
    }

</div>