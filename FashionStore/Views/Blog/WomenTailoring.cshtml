@model IEnumerable<FashionStore.Repository.Models.News>
@{
    ViewData["Title"] = ViewBag.CategoryName;
    ViewData["MetaDescription"] = "Redefine elegance with women's bespoke tailoring at Ulim Tailor Hanoi. From refined women's suits to individually crafted designs, every piece is tailored to complement your silhouette, express your individuality, and reflect timeless sophistication.";

    var index = 0;
}
<picture>
    <source media="(min-width: 992px)" srcset="/image/women-tailorinng-unlimtailor-1.webp">
    <source media="(min-width: 576px)" srcset="/image/women-tailorinng-unlimtailor-1.webp">
    <img src="/image/women-tailorinng-unlimtailor-1.webp" class="img-fluid w-100" alt="Bespoke Tailoring for Women Unlim tailor">
</picture>
<h1 class="container text-dark text-uppercase fs-2 text-center mt-2">
    @ViewBag.CategoryName
</h1>
<div class="container mt-3">
    @foreach (var item in Model)
    {
        var isEven = index % 2 == 0;
        <ar class="row align-items-center mb-5">
            <div class="col-lg-6 col-md-6 col-12 @(isEven ? "order-md-1" : "order-md-2") order-2">
                <div class="pe-lg-5">
                    <h4 class="fs-5">
                        <a asp-action="Details" asp-route-slug="@item.Slug" class="editorial-title text-decoration-none text-dark ">
                            @item.Title
                        </a>
                    </h4>

                    <p class="text-muted">
                        @item.Summary
                    </p>
                    <a asp-action="Details" asp-route-slug="@item.Slug" class="see-more-link text-decoration-none text-dark fw-semibold">
                        See more <i class="ri-arrow-right-wide-line"></i>
                    </a>

                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12 @(isEven ? "order-md-2" : "order-md-1") order-1 mb-3 mb-md-0">
                <div class="ratio ratio-16x9">
                    <img src="@item.ImageUrl" class="img-fluid" style="object-fit: cover;" alt="@item.Title">
                </div>
            </div>
        </ar>
        index++;
    }
</div>
