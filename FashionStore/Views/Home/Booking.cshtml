@{
    ViewData["Title"] = "UNLIM Tailor";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landbook.css" asp-append-version="true" />
}
    <!-- 1. HERO SECTION -->
    <section class="hero-fullscreen">
        <div class="container text-center">
            <h6 class="text-gold tracking-widest mb-4">EST. HANOI</h6>
            <h1 class="display-2 font-serif mb-4">UNLIM TAILOR</h1>
            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <p class="lead-text text-light mb-5">
                        Going far beyond the limitations of conventional menswear, we create garments that become a true extension of the wearer—crafted as a second skin that reflects individual character and style. Each bespoke masterpiece is meticulously handmade, designed exclusively to embody your confidence, distinction, and personal pride.
                    </p>
                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-4">
                        <a href="/Booking/Index" class="btn-gold-solid">
                            <i class="fa-solid fa-calendar-check me-2"></i> Book An Appointment
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. BRAND ETHOS - TRIẾT LÝ -->
    <section class="py-5 my-5">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-5">
                    <img src="https://images.unsplash.com/photo-1594938291221-94f18cbb5660?auto=format&fit=crop&q=80&w=800" alt="Bespoke Tailoring" class="img-fluid rounded">
                </div>
                <div class="col-lg-7 ps-lg-5">
                    <h5 class="text-gold tracking-widest mb-3 small">The ART OF EXCELLENCE</h5>
                    <h2 class="display-5 font-serif mb-4">The Pursuit of Perfection</h2>
                    <p class="mb-4 lead-text">
                        Nestled in a quiet corner of Kim Ma Street, UNLIM Tailor is where fine tailoring meets the artistry of traditional craftsmanship. We believe that a truly exceptional suit is defined not only by its outward appearance, but also by the intricate construction hidden beneath the surface. Every garment is meticulously crafted with an unwavering commitment to detail, ensuring elegance, comfort, and lasting character.
                    </p>
                    <p class="mb-5">
                        Using the traditional Full Canvas construction method—crafted entirely by hand with a horsehair canvas foundation—thousands of meticulous hand stitches are placed to sculpt and shape the chest. Over time, the jacket gradually adapts to your posture and natural movements, creating a fit that becomes increasingly personal, comfortable, and remarkably refined with every wear.
                    </p>
                    <a href="tel:0912345678" class="text-gold text-decoration-none tracking-wide text-uppercase font-serif border-bottom border-gold pb-1">
                        Call Our Hotline for More Information <i class="fa-solid fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. FABRIC COLLECTIONS - CHẤT LIỆU THƯỢNG HẠNG -->
    <section class="py-5" style="background-color: var(--secondary-bg);">
        <div class="container py-5">
            <div class="text-center mb-5 pb-4">
                <h5 class="text-gold tracking-widest mb-3 small">FABRIC COLLECTION</h5>
                <h2 class="display-5 font-serif">The Foundation of True Elegance</h2>
                <p class="col-lg-6 mx-auto mt-3">True sophistication begins with the finest Merino wool fibers. Explore a curated selection of world-renowned fabrics, sourced from prestigious mills and now available at UNLIM Tailor for your next bespoke creation.</p>
            </div>

            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="fabric-card">
                        <h3 class="font-serif text-light mb-3">Giorgio</h3>
                        <p class=" small mb-4">A premium wool-blend fabric engineered for impeccable drape and outstanding wrinkle resistance. Combining elegance with practicality, it is the preferred choice for business professionals who travel frequently and require a polished appearance throughout the day.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="fabric-card">
                        <h3 class="font-serif text-light mb-3">Medici</h3>
                        <p class=" small mb-4">Woven from luxurious Super 130s wool, this distinguished cloth combines a silky hand feel with remarkable structure and precision. Its clean lines and impeccable drape project an air of authority and sophistication, making it an exceptional choice for black-tie events, gala evenings, and red-carpet appearances.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="fabric-card">
                        <h3 class="font-serif text-light mb-3">Pasio</h3>
                        <p class=" small mb-4">Featuring sophisticated Windowpane checks and delicately woven Pinstripes, these fabrics strike the perfect balance between personality and refinement. Ideal for gentlemen who appreciate distinctive style while maintaining an air of effortless elegance.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="fabric-card">
                        <h3 class="font-serif text-light mb-3">Linen & Silk</h3>
                        <p class=" small mb-4">The perfect tailoring solution for tropical summers. Crafted from breathable twill-woven linen blended with natural silk fibers, this fabric offers exceptional comfort and airflow while maintaining an effortlessly refined and sophisticated appearance.</p>
                    </div>
                </div>
            </div>

            <div class="text-center mt-5 pt-3">
                <a href="/Booking/Index" class="btn-gold-solid">Experience the Fabrics Firsthand</a>
            </div>
        </div>
    </section>

    <!-- 4. BESPOKE JOURNEY - QUY TRÌNH -->
    <section class="p-4">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-5 mb-lg-0">
                    <h5 class="text-gold tracking-widest mb-3 small">The Bespoke Journey</h5>
                    <h3 class="display-5 font-serif mb-4">The Art of the Bespoke Journey</h3>
                    <p class="lead-text">A true bespoke suit requires patience. At UNLIM, the journey takes between three and four weeks, involving dozens of hours of meticulous handcraftsmanship by our most skilled artisans. Every stage is carried out with precision and care, ensuring a garment that is uniquely yours in both fit and character.</p>
                </div>
                <div class="col-lg-7 offset-lg-1">
                    <div class="timeline-box">
                        <div class="timeline-step">I</div>
                        <h4 class="font-serif text-light mb-2">Consultation & Measurement</h4>
                        <p class=" small">Enjoy a glass of whisky or a cup of hot tea while meeting with our master tailor. We take the time to understand your lifestyle, personal preferences, and professional environment. More than 20 body measurements, along with unique anatomical characteristics such as sloping shoulders, a rounded back, or arm asymmetry, are carefully recorded to create a garment tailored exclusively to you.</p>
                    </div>

                    <div class="timeline-box">
                        <div class="timeline-step">II</div>
                        <h4 class="font-serif text-light mb-2">Preliminary Fitting (First Fitting)</h4>
                        <p class="small">Around two days later, you will attend a basted fitting. The suit, temporarily assembled with white basting stitches, allows our tailor to make precise adjustments to balance, fit, and comfort—ensuring a silhouette that is both elegant and effortless to wear.</p>
                    </div>

                    <div class="timeline-box">
                        <div class="timeline-step">III</div>
                        <h4 class="font-serif text-light mb-2">Attention to Detail (Second Fitting)</h4>
                        <p class=" small">The suit is now approximately 90% complete. Our master tailor carefully refines the sleeve length, trouser break, and overall drape, while ensuring the shoulders and chest fit smoothly and naturally for a polished silhouette.</p>
                    </div>

                    <div class="timeline-box">
                        <div class="timeline-step">IV</div>
                        <h4 class="font-serif text-light mb-2">The Final Reveal</h4>
                        <p class=" small">The final garment undergoes meticulous steam-finishing to perfect its shape and drape. Genuine horn and mother-of-pearl buttons are hand-sewn with precision, while your name is silk-embroidered inside the lining—a personal signature that marks the ownership of a truly unique bespoke masterpiece..</p>
                    </div>

                </div>
            </div>
        </div>
    </section>

    <!-- 5. FINAL CALL TO ACTION -->
<section>
        <div class="container text-center py-5">
            <h2 class="display-4 font-serif mb-4 text-light">Let Us Serve You.</h2>
            <p class="col-lg-8 font-serif lead-text mb-3 mx-auto">
                A testament to the confidence of a successful man. Book an appointment today to receive the most attentive consultation from bespoke tailoring experts at UNLIM TAILOR.
            </p>
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-4">
                <a href="/Booking/Index" class="btn-gold-solid px-5 py-3">
                    <i class="fa-solid fa-calendar-check me-2"></i>Confirm Your Tailoring Appointment
                </a>
                <a href="tel:0912345678" class="btn-gold-outline px-5 py-3 text-white border-white hover-gold">
                    <i class="fa-solid fa-phone me-2"></i> Hotline: 098 947 3579
                </a>
            </div>
            <p class="mt-4 small tracking-wide"><i class="fa-solid fa-location-dot text-gold me-2"></i>105-107 Kim Ma Street, Ba Dinh Ward, HaNoi</p>
        </div>
    </section>

    <!-- FLOATING ACTIONS DESKTOP -->
    <div class="float-btn-group d-none d-lg-block">
        <a href="https://wa.me/84912345678" class="float-btn bg-whatsapp"><i class="fa-brands fa-whatsapp"></i></a>
        <a href="https://m.me/unlimtailor" class="float-btn bg-messenger"><i class="fa-brands fa-facebook-messenger"></i></a>
        <a href="tel:0912345678" class="float-btn bg-phone"><i class="fa-solid fa-phone"></i></a>
    </div>

    <!-- MOBILE STICKY BOTTOM TOOLBAR -->
    <div class="mobile-cta fixed-bottom d-block d-lg-none py-2 px-3">
        <div class="row text-center align-items-center g-1">
            <div class="col-3">
                <a href="tel:0912345678" class="text-decoration-none text-light d-flex flex-column align-items-center">
                    <i class="fa-solid fa-phone fs-5 mb-1 text-gold"></i>
                    <span style="font-size: 0.65rem;" class="text-uppercase tracking-wide">Gọi Điện</span>
                </a>
            </div>
            <div class="col-3">
                <a href="https://m.me/unlimtailor" class="text-decoration-none text-light d-flex flex-column align-items-center">
                    <i class="fa-brands fa-facebook-messenger fs-5 mb-1 text-primary"></i>
                    <span style="font-size: 0.65rem;" class="text-uppercase tracking-wide">Nhắn Tin</span>
                </a>
            </div>
            <div class="col-6">
                <a href="/Booking/Index" class="btn-gold-solid py-2 w-100 d-block fs-6" style="padding: 10px 0;">
                    ĐẶT LỊCH NGAY
                </a>
            </div>
        </div>
    </div>