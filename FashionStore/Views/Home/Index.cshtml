@model IEnumerable<FashionStore.Repository.Models.Product>

@{
    ViewData["Title"] = "Bespoke Tailor In Hanoi | Bespoke Tailoring Services  | UNLIM Tailor";
    ViewData["MetaDescription"] = "Unlim Tailor offers bespoke tailoring services for suits, tuxedos, and high-end men's attire in Hanoi's Old Quarter and downtown. Experience the exquisite craftsmanship and timeless style for both domestic and international clients.";
}
<link href="/css/site.css" rel="stylesheet" />
<div id="heroCarousel" class="carousel slide shadow overflow-hidden" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" aria-label="Slide 1" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" aria-label="Slide 2" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active" data-bs-interval="3000">
            <picture>
                <source media="(max-width: 767px)" srcset="/image/carousel-light-kt212.png">
                <img src="~/image/hero-bnxhid1.png" class="d-block w-100 carousel-img h-100" alt="unlimtailor bespoke in hanoi">
            </picture>

            <div class="carousel-caption text-center unlim-caption">
                <a asp-controller="Appointment" asp-action="Index" class="booking-btn">
                    BOOK AN APPOINTMENT
                </a>
            </div>
        </div>
        <div class="carousel-item" data-bs-interval="3000">
            <picture>
                <source media="(max-width: 767px)" srcset="/image/carousel-light-kt213.png">
                <img src="~/image/banner_home.png" class="d-block w-100 carousel-img h-100" alt="tailor near me old the quarter in hanoi">
            </picture>

            <div class="carousel-caption text-center unlim-caption">
                <a asp-controller="Appointment" asp-action="Index" class="booking-btn">
                    BOOK AN APPOINTMENT
                </a>
            </div>
        </div>

    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" aria-label="carusel-left">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" aria-label="carusel-right">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>
<div class="video-bg">
    <video class="video-desktop" autoplay muted loop playsinline preload="none" aria-hidden="true" tabindex="-1">
        <source src="/image/clipindex.mp4" type="video/mp4">
    </video>
    <img src="/image/amv2g.png" class="video-mobile w-100" alt="background-unlimtailor-107kimma">
</div>
<section class="services-section d-md-block d-none">
    <div class="container">
        <h2 class="services-title text-center mb-4 mt-5">Our Services & Offers</h2>
        <div class="devider"></div>
        <div class="row text-center">
            <div class="col-lg-3 col-md-6">
                <div class="service-card">
                    <img src="~/image/BESPOKE.png" alt="Bespoke Tailoring" class="object-fit-contain">
                    <h5 class="service-title">BESPOKE<br>TAILORING</h5>
                    <p class="service-text">
                        By taking 30 measurements, multiple fitting sessions, and offering customizable details from pocket to lining,
                        we provide suits tailored perfectly to your body and personality.
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="service-card">
                    <img src="~/image/ALTERATION.png" alt="Alteration and Care" class="object-fit-contain">
                    <h5 class="service-title">ALTERATION<br>AND CARE</h5>
                    <p class="service-text">
                        High-quality bespoke alterations with precision and care. Returning customers may also enjoy our premium
                        dry-cleaning services at a preferred price.
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="service-card">
                    <img src="~/image/setphukien.png" alt="Hand-made Accessories" class="object-fit-contain">
                    <h5 class="service-title">HAND-MADE<br>ACCESSORIES</h5>
                    <p class="service-text">
                        Handcrafted accessories from artisans worldwide including neckties, pocket squares, leather gloves and shoes,
                        made with the finest materials.
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="service-card">
                    <img src="~/image/time-detail.png" alt="Flexible Schedule" class="object-fit-contain">
                    <h5 class="service-title">FLEXIBLE<br>SCHEDULE</h5>
                    <p class="service-text">
                        We adapt to your schedule with flexible timelines. Simply tell us your availability and we’ll arrange meetings
                        accordingly for your convenience.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="partner-section container d-md-block d-none">
    <h2 class="partner-title"> Our Partners </h2>
    <div class="partner-slider">
        <div class="partner-track">
            <div class="partner-item"><img src="/image/brand/brand_1.jpg" alt="brand fabric"></div>
            <div class="partner-item"><img src="/image/brand/brand_2.jpg" alt="brand fabric"></div>
            <div class="partner-item"><img src="/image/brand/brand_3.jpg" alt="brand fabric"></div>
            <div class="partner-item"><img src="/image/brand/brand_4.jpg" alt="brand fabric"></div>
            <div class="partner-item"><img src="/image/brand/scabal.jpg" alt="brand fabric"></div>
            <div class="partner-item"><img src="/image/brand/brand_6.jpg" alt="brand fabric"></div>
            <div class="partner-item"><img src="/image/brand/Zegna.png" alt="brand fabric"></div>
            <div class="partner-item"><img src="/image/brand/lanificio-cerruti.jpg" alt="brand fabric"></div>
            <div class="partner-item"><img src="/image/brand/brand_1.jpg" alt="brand fabric"></div>
            <div class="partner-item"><img src="/image/brand/brand_2.jpg" alt="brand fabric"></div>
            <div class="partner-item"><img src="/image/brand/brand_3.jpg" alt="brand fabric"></div>
            <div class="partner-item"><img src="/image/brand/brand_4.jpg" alt="brand fabric"></div>
            <div class="partner-item"><img src="/image/brand/scabal.jpg" alt="brand fabric"></div>
            <div class="partner-item"><img src="/image/brand/brand_6.jpg" alt="brand fabric"></div>
            <div class="partner-item"><img src="/image/brand/Zegna.png" alt="brand fabric"></div>
            <div class="partner-item"><img src="/image/brand/lanificio-cerruti.jpg" alt="brand fabric"></div>
        </div>
    </div>
</section>
