@model IEnumerable<FashionStore.Repository.Models.Product>

@{
    ViewData["Title"] = "UNLIM TAILOR | Bespoke Tailor in Hanoi";
    ViewData["MetaDescription"] = "Our clients are politicians, businesspeople, and influencers – individuals who are not only successful in their careers but also represent the image of an entire group, organization, or nation. We understand that every time you appear before the public, the media, or partners, your image must project composure, dignity, and class.";
}
<link href="/css/site.css" rel="stylesheet" />
<div id="heroCarousel" class="carousel slide shadow overflow-hidden" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" aria-label="Slide 1" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" aria-label="Slide 2" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active" data-bs-interval="3000">
            <a asp-controller="Suit" asp-action="Index" class="d-block">
                <picture>
                    <source media="(max-width: 767px)" srcset="/image/carousel-light-kt212.png">
                    <img src="~/image/coat-shirt-red-in-hanoi-unlim.jpg" class="d-block w-100 carousel-img h-100" alt="unlimtailor bespoke in hanoi">
                </picture>
            </a>
            <div class="carousel-caption text-center unlim-caption">
                <h1>UNLIM TAILOR</h1>
                <a asp-controller="Appointment" asp-action="Index" class="booking-btn">
                    BOOK AN APPOINTMENT
                </a>
            </div>
        </div>
        <div class="carousel-item" data-bs-interval="3000">
            <a asp-controller="Suit" asp-action="Index" class="d-block">
                <picture>
                    <source media="(max-width: 767px)" srcset="/image/responsive-slide.jpg">
                    <img src="~/image/unlimtailor_1suit.jpg" class="d-block w-100 carousel-img h-100" alt="tailor near me old the quarter in hanoi">
                </picture>
            </a>
            <div class="carousel-caption text-center unlim-caption">
                <a asp-controller="Appointment" asp-action="Index" class="booking-btn">
                    BOOK AN APPOINTMENT
                </a>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" aria-label="carusel-left">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" aria-label="carusel-right">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>
<section class="services-section">
    <div class="container">
        <h2 class="services-title text-center mt-5 text-dark">How it works</h2>
        <div class="row">
            <div class="col-lg-3 col-md-6">
                <div class="service-card">
                    <img src="~/image/process/fabric-selection.png" alt="Bespoke Tailoring" class="object-fit-contain">
                    <h5 class="service-title">Fabic & Bespoke Tailoring</h5>
                    <p class="service-text">
                        By taking 30 measurements, multiple fitting sessions, and offering customizable details from pocket to lining,
                        we provide suits tailored perfectly to your body and personality.
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="service-card">
                    <img src="~/image/process/reach-a-consensus.png" alt="Alteration and Care" class="object-fit-contain">
                    <h5 class="service-title">Consensus & Care</h5>
                    <p class="service-text">
                        We provide attentive consultation and dedicated aftercare, ensuring every bespoke garment maintains its elegance, comfort, and long-lasting quality.
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="service-card">
                    <img src="~/image/process/fitting&fix.png" alt="Hand-made Accessories" class="object-fit-contain">
                    <h5 class="service-title">Fitting & Alterations</h5>
                    <p class="service-text">
                        Through precise fittings and alterations, each garment is refined to complement your posture, movement, and personal style with a flawless bespoke finish.
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="service-card">
                    <img src="~/image/process/complete-suit-unlim.png" alt="Flexible Schedule" class="object-fit-contain">
                    <h5 class="service-title">Completion & Delivery</h5>
                    <p class="service-text">
                        We adapt to your schedule with flexible timelines. Simply tell us your availability and we’ll arrange meetings
                        accordingly for your convenience.
                    </p>
                </div>
            </div>
        </div>
        <div class="text-center mb-2">
            <a asp-controller="AboutUs" asp-action="Index" class="btn btn-outline-dark mb-3 mt-3 text-center">Learn more</a>
        </div>
    </div>
</section>
<section class="craft-showunlim-bg">
    <div class="container craft-showcase unlim-journey-section py-4">
        <div class="showcase-header mb-5">
            <h2>Unlim Tailor's Process</h2>
        </div>
        <div id="journeyCarousel" class="carousel slide" data-bs-ride="false">
            <div class="carousel-inner">
                <div class="carousel-item active ">
                    <div class="row g-2">
                        <div class="col-12 col-md-4">
                            <div class="craft-card bg-warning-subtle">
                                <div class="card-image-wrap">
                                    <img src="/image/B1 (2).png" alt="Consultation at UNLIM Tailor">
                                </div>
                                <div class="card-body text-center">
                                    <h4>Consultation</h4>
                                    <p>
                                        Design consultation: the first chapter in shaping personal identity and elegant style.
                                    </p>
                                </div>

                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="craft-card bg-warning-subtle">
                                <div class="card-image-wrap">
                                    <img src="/image/B2 (2).png" alt="Measurements at UNLIM Tailor">
                                </div>
                                <div class="card-body text-center">
                                    <h4>Measurements</h4>
                                    <p>
                                        Meticulous stitching and precise measurements: the foundation for a perfect suit.
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="craft-card bg-warning-subtle">
                                <div class="card-image-wrap">
                                    <img src="/image/B3.jpg" alt="Fabric selection at UNLIM Tailor">
                                </div>
                                <div class="card-body text-center">
                                    <h4>Fabric Selection</h4>
                                    <p>
                                        We select only the finest fabrics from thousands of renowned fabric samples worldwide.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="carousel-item">
                    <div class="row g-4">
                        <div class="col-12 col-md-4">
                            <div class="craft-card bg-warning-subtle">
                                <div class="card-image-wrap">
                                    <img src="/image/B4.jpg" alt="Fitting and editing at UNLIM Tailor">
                                </div>
                                <div class="card-body text-center">
                                    <h4>Fitting &amp; Editing</h4>
                                    <p>
                                        The perfect outfits are created by the most skilled and excellent tailors we have.
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="craft-card bg-warning-subtle">
                                <div class="card-image-wrap">
                                    <img src="/image/B5.png" alt="Completion at UNLIM Tailor">
                                </div>
                                <div class="card-body text-center">
                                    <h4>Completion</h4>
                                    <p>
                                        A moment of pride, where the art of craftsmanship meets timeless values.
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="craft-card bg-warning-subtle">
                                <div class="card-image-wrap">
                                    <img src="/image/care-and-maintenance.jpg" alt="Care and maintenance at UNLIM Tailor">
                                </div>
                                <div class="card-body text-center">
                                    <h4>Care &amp; Maintenance</h4>
                                    <p>
                                        Preserving the elegance and longevity of your bespoke garments.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#journeyCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#journeyCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>
    <div class="text-center mb-2">
        <a asp-controller="contact" asp-action="Index" class="btn btn-outline-light mb-3 mt-3 text-center">Request Consultation</a>
    </div>
</section>
