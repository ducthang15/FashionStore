@model IEnumerable<FashionStore.Repository.Models.Product>

@{
    ViewData["Title"] = "UNLIM TAILOR | Bespoke Tailor in Hanoi";
    ViewData["MetaDescription"] = "Our clients are politicians, businesspeople, and influencers – individuals who are not only successful in their careers but also represent the image of an entire group, organization, or nation. We understand that every time you appear before the public, the media, or partners, your image must project composure, dignity, and class.";
}
<link href="/css/site.css" rel="stylesheet" />
<div id="heroCarousel" class="carousel slide shadow overflow-hidden" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" aria-label="Slide 1" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" aria-label="Slide 2" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active" data-bs-interval="3000">
            <picture>
                <source media="(max-width: 767px)" srcset="/image/carousel-light-kt212.png">
                <img src="~/image/hero-bnxhid1.jpg" class="d-block w-100 carousel-img h-100" alt="unlimtailor bespoke in hanoi">
            </picture>
            <div class="carousel-caption text-center unlim-caption">
                <h1>UNLIM TAILOR</h1>
                <a asp-controller="Appointment" asp-action="Index" class="booking-btn">
                    BOOK AN APPOINTMENT
                </a>
            </div>
        </div>
        <div class="carousel-item" data-bs-interval="3000">
            <picture>
                <source media="(max-width: 767px)" srcset="/image/carousel-light-kt213.jpg">
                <img src="~/image/banner_home.png" class="d-block w-100 carousel-img h-100" alt="tailor near me old the quarter in hanoi">
            </picture>
            <div class="carousel-caption text-center unlim-caption">
                <a asp-controller="Appointment" asp-action="Index" class="booking-btn">
                    BOOK AN APPOINTMENT
                </a>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" aria-label="carusel-left">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" aria-label="carusel-right">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>
