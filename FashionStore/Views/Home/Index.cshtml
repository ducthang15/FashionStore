<section class="main-bg-brown">
    <section class="collection-section">
        <div class="container relative mt-5 mb-5">
            <div class="text-center mb-3">
                <h2 class="collection-title text-dark">The Collection</h2>
                <p class="collection-subtitle text-dark">You can customize the fabric, color, and every detail to create a suit that's uniquely yours.</p>
            </div>
            <div class="position-relative px-md-5">
                <button class="slick-arrow-custom prev-arrow" id="slidePrev" type="button" aria-label="Previous slide">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
                    </svg>
                </button>
                <button class="slick-arrow-custom next-arrow" id="slideNext" type="button" aria-label="Next slide">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-arrow-right" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z" />
                    </svg>
                </button>
                <div id="suitSlider" class="row">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <div class="suit-card">
                                <div class="suit-card-inner">
                                    <a asp-controller="Home" asp-action="Details" asp-route-slug="@item.Slug" class="text-decoration-none">
                                        <div class="suit-image-wrapper">
                                            <img src="@item.ImageUrl" alt="@item.ProductName" class="img-fluid" loading="lazy">
                                        </div>
                                    </a>

                                    <div class="suit-info-box">
                                        <h3 class="suit-name text-clamp-2">@item.ProductName</h3>
                                        <p class="suit-type">Product line: @item.Category?.CategoryName</p>
                                        <a asp-controller="Home" asp-action="Details" asp-route-slug="@item.Slug" class="btn-detail-arrow text-decoration-none rounded-4">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-up-right" viewBox="0 0 16 16">
                                                <path fill-rule="evenodd" d="M14 2.5a.5.5 0 0 0-.5-.5h-6a.5.5 0 0 0 0 1h4.793L2.146 13.146a.5.5 0 0 0 .708.708L13 3.707V8.5a.5.5 0 0 0 1 0v-6z" />
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">No custom designs available at the moment.</div>
                    }
                </div>

            </div>
        </div>
    </section>
    <section class="services-section">
        <div class="container">
            <h2 class="services-title text-center mt-5">How it works</h2>
            <h6 class="text-center">Still not convinced we're a good fit for one another? Let us prove it.</h6>
            <div class="text-center mb-2">
                <a asp-controller="AboutUs" asp-action="Index" class="btn btn-outline-light mb-3 mt-3 text-center">Learn more</a>
            </div>
            <div class="row">
                <div class="col-lg-3 col-md-6">
                    <div class="service-card">
                        <img src="~/image/process/fabric-selection.png" alt="Bespoke Tailoring" class="object-fit-contain">
                        <h5 class="service-title">Fabic & Bespoke Tailoring</h5>
                        <p class="service-text">
                            By taking 30 measurements, multiple fitting sessions, and offering customizable details from pocket to lining,
                            we provide suits tailored perfectly to your body and personality.
                        </p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="service-card">
                        <img src="~/image/process/reach-a-consensus.png" alt="Alteration and Care" class="object-fit-contain">
                        <h5 class="service-title">Consensus & Care</h5>
                        <p class="service-text">
                            We provide attentive consultation and dedicated aftercare, ensuring every bespoke garment maintains its elegance, comfort, and long-lasting quality.
                        </p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="service-card">
                        <img src="~/image/process/fitting&fix.png" alt="Hand-made Accessories" class="object-fit-contain">
                        <h5 class="service-title">Fitting & Alterations</h5>
                        <p class="service-text">
                            Through precise fittings and alterations, each garment is refined to complement your posture, movement, and personal style with a flawless bespoke finish.
                        </p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="service-card">
                        <img src="~/image/process/complete-suit-unlim.png" alt="Flexible Schedule" class="object-fit-contain">
                        <h5 class="service-title">Completion & Delivery</h5>
                        <p class="service-text">
                            We adapt to your schedule with flexible timelines. Simply tell us your availability and we’ll arrange meetings
                            accordingly for your convenience.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="partner-section container d-md-block d-none">
        <h2 class="partner-title"> Our Partners </h2>
        <div class="partner-slider">
