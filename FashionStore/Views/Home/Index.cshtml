<div class="video-bg">
	<video autoplay muted loop playsinline>
		<source src="/image/clipindex.mp4" type="video/mp4">
	</video>
</div>
<section class="services-section">
	<div class="container">
		<h2 class="services-title text-center mb-4 mt-5 text-dark">Our Services & Offers</h2>
		<div class="devider"></div>
		<div class="row text-center g-5">
			<div class="col-lg-3 col-md-6">
				<div class="service-card">
					<img src="~/image/12.png" alt="Bespoke Tailoring">
					<h5 class="service-title">BESPOKE<br>TAILORING</h5>
					<p class="service-text">
						By taking 30 measurements, multiple fitting sessions, and offering customizable details from pocket to lining,
						we provide suits tailored perfectly to your body and personality.
					</p>
				</div>
			</div>

			<div class="col-lg-3 col-md-6">
				<div class="service-card">
					<img src="~/image/Untitled.png" alt="Alteration and Care">
					<h5 class="service-title">ALTERATION<br>AND CARE</h5>
					<p class="service-text">
						High-quality bespoke alterations with precision and care. Returning customers may also enjoy our premium
						dry-cleaning services at a preferred price.
					</p>
				</div>
			</div>

			<div class="col-lg-3 col-md-6">
				<div class="service-card">
					<img src="~/image/12.png" alt="Hand-made Accessories">
					<h5 class="service-title">HAND-MADE<br>ACCESSORIES</h5>
					<p class="service-text">
						Handcrafted accessories from artisans worldwide including neckties, pocket squares, leather gloves and shoes,
						made with the finest materials.
					</p>
				</div>
			</div>

			<div class="col-lg-3 col-md-6">
				<div class="service-card">
					<img src="~/image/234.png" alt="Flexible Schedule">
					<h5 class="service-title">FLEXIBLE<br>SCHEDULE</h5>
					<p class="service-text">
						We adapt to your schedule with flexible timelines. Simply tell us your availability and we’ll arrange meetings
						accordingly for your convenience.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>
<section class="partner-section container">
	<h2 class="partner-title"> Our Partners </h2>
	<div class="partner-slider">
		<div class="partner-track">

			<!-- Logo -->
			<div class="partner-item"><img src="/image/brand/brand_1.jpg"></div>
			<div class="partner-item"><img src="/image/brand/brand_2.jpg"></div>
			<div class="partner-item"><img src="/image/brand/brand_3.jpg"></div>
			<div class="partner-item"><img src="/image/brand/brand_4.jpg"></div>
			<div class="partner-item"><img src="/image/brand/brand_6.jpg"></div>

			<!-- Lặp lại để tạo hiệu ứng infinite -->
			<div class="partner-item"><img src="/image/brand/brand_1.jpg"></div>
			<div class="partner-item"><img src="/image/brand/brand_2.jpg"></div>
			<div class="partner-item"><img src="/image/brand/brand_3.jpg"></div>
			<div class="partner-item"><img src="/image/brand/brand_4.jpg"></div>
			<div class="partner-item"><img src="/image/brand/brand_6.jpg"></div>

		</div>
	</div>
</section>
