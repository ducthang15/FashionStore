@if (ViewBag.LatestNews != null)
{
    <section class="latest-blog py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="title-journal text-dark">Our Journal</h2>
            </div>
            <div class="row g-2 mt-4">
                @foreach (var item in ViewBag.LatestNews)
                {
                    <div class="col-lg-4 col-md-6">
                        <article class="blog-card h-100">

                            <div class="blog-image-wrapper">
                                <a asp-controller="Blog" asp-action="Details" asp-route-slug="@item.Slug" class="text-decoration-none">
                                    <img src="@item.ImageUrl" alt="@item.Title" class="img-fluid w-100" loading="lazy">
                                </a>
                            </div>
                            <div class="pt-3">
                                <div class="small text-muted mb-2">
                                    @(item.CreatedAt?.ToString("dd/MM/yyyy") ?? "")
                                </div>
                                <h6 class="title-blog-journal text-truncate fw-semibold">
                                    <a asp-controller="Blog" asp-action="Details" asp-route-slug="@item.Slug" class="text-decoration-none text-dark">
                                        @item.Title
                                    </a>
                                </h6>
                                <p class="summary-title-blog text-muted text-clamp-3">
                                    @item.Summary
                                </p>
                                <a asp-controller="Blog" asp-action="Details" asp-route-slug="@item.Slug" class="text-warning text-decoration-none">
                                    Read more
                                    <i class="ri-arrow-right-line"></i>
                                </a>
                            </div>
                        </article>
                    </div>
                }
            </div>
            <div class="text-center mt-5">
                <a asp-controller="Blog" asp-action="Index" class="btn btn-outline-dark px-4">
                    View All Articles
                </a>
            </div>
        </div>
    </section>
}
