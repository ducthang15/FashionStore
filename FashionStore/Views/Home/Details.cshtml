@model FashionStore.Repository.Models.Product
@{
    ViewData["Title"] = Model.ProductName;
}
<div class="container-fluid product-dark py-5">
    <div class="container mt-5">
        <nav class="breadcrumb-title mb-4 small">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-light text-uppercase">
                Home
            </a>
            <span class="mx-2">/</span>
            <a asp-controller="@Model.Category.CategoryName" asp-action="Index" class="text-decoration-none text-secondary text-uppercase fw-bold">
                @Model.Category.CategoryName
            </a>
            <span class="mx-2">/</span>
            <span class="text-white fw-semibold text-uppercase">
                @Model.ProductName
            </span>
        </nav>
        <div class="row g-4">
            <div class="col-lg-7 d-flex">
                <div class="d-flex flex-column gap-2 me-5">
                    @foreach (var img in Model.ProductImages)
                    {
                        <img src="@img.ImageUrl" onclick="changeMainImage(this)" width="70" alt="@Model.ProductName - detail images">
                    }
                </div>
                <div class="flex-grow-1 justify-content-center">
                    <img id="mainImage" src="@Model.ImageUrl" class="img-fluid rounded border w-75" alt="@Model.ProductName">
                </div>
            </div>
            <div class="col-lg-5 product-info d-flex flex-column">
                <div class="flex-grow-1">
                <h2 class="fw-bold mb-2">@Model.ProductName</h2>
                <span class="text-secondary">
                        <strong>Product type: @Model.Category?.CategoryName</strong>
                </span><br>
                    <span class="text-secondary">
                    @Html.Raw(Model.Description)
                </span>
                </div>
                <div class="text-center mt-auto pt-4">
                    CONTACT: <span class="text-danger">098 947 3579</span> để biết thêm chi tiết!
                </div>
                <hr class="border-secondary">
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-dark border-secondary">
            <div class="modal-header border-0">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 overflow-hidden text-center">
                <img id="modalImage" src="" class="img-fluid" style="cursor: zoom-in; transition: transform 0.2s ease;">
            </div>
        </div>
    </div>
</div>
<a href="https://www.facebook.com/MAYDOSUITCAOCAP" target="_blank" class="messenger-circle">
    <i class="fa-brands fa-facebook-messenger"></i>
</a>
<a href="tel:0989473579" class="call-circle">
    <i class="fa-solid fa-phone"></i>
</a>
<a href="https://zalo.me/0989473579" target="_blank" class="zalo-circle">
    <img src="https://upload.wikimedia.org/wikipedia/commons/9/91/Icon_of_Zalo.svg" alt="Zalo" />
</a>
<script>
    function changeMainImage(el) {
        document.getElementById("mainImage").src = el.src;
        document.querySelectorAll(".thumb-item").forEach(x => x.classList.remove("active"));
    el.classList.add("active");
    }
</script>
