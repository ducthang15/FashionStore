@model FashionStore.Repository.Models.Product
@{
    ViewData["Title"] = Model.ProductName;
}
<div class="container-fluid product-dark py-4">
    <div class="container">
        <nav class="breadcrumb-title mb-4 small">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-light text-uppercase">
                Home
            </a>
            <span class="mx-2">/</span>
            <a asp-controller="@Model.Category.CategoryName" asp-action="Index" class="text-decoration-none text-secondary text-uppercase fw-bold">
                @Model.Category.CategoryName
            </a>
            <span class="mx-2">/</span>
            <span class="text-white fw-semibold text-uppercase">
                @Model.ProductName
            </span>
        </nav>
        <div class="row">
            <div class="col-lg-7 d-flex">
                <div class="d-flex flex-column gap-2 me-5">
                    @foreach (var img in Model.ProductImages)
                    {
                        <img src="@img.ImageUrl" onclick="changeMainImage(this)" width="70" alt="@Model.ProductName - detail images">
                    }
                </div>
                <div class="flex-grow-1 justify-content-center">
                    <img id="mainImage" src="@Model.ImageUrl" class="img-fluid rounded border w-75" alt="@Model.ProductName">
                </div>
            </div>
            <div class="col-lg-5 product-info d-flex flex-column">
                <div class="detail-product-catalog">
                    <h1 class="fs-4 mt-3">@Model.ProductName</h1>
                    <span class="text-white">
                        <span class="fs-6">Product catalog: @Model.Category?.CategoryName</span>
                    </span><br>
                </div>
                <div class="infomation-contact">
                    <div class="text-dark">
                        <div class="text-white">
                            Booking: <strong class="fw-bold">0989 473 579</strong>
                        </div>
                        <div class="d-flex align-items-center gap-4">
                            <a href="https://www.facebook.com/MAYDOSUITCAOCAP" class="text-white text-decoration-none fs-1">
                                <i class="ri-facebook-fill"></i>
                            </a>
                            <a href="https://wa.me/84989473579" class="text-white text-decoration-none fs-1">
                                <i class="ri-whatsapp-line"></i>
                            </a>
                            <a href="https://www.instagram.com/unlim.tailor/" class="text-white text-decoration-none fs-1 mt-1">
                                <i class="fa-brands fa-instagram"></i>
                            </a>
                            <a href="https://www.tripadvisor.com/Attraction_Review-g293924-d33295118-Reviews-Unlim_Tailor-Hanoi.html" class="mb-1 tripadvisor-infomation text-decoration-none fs-1">
                                <img src="/image/brand/tripad.png" alt="tripadvisor.com" />
                            </a>
                            <a href="https://zalo.me/0989473579" class="zalo-infomation text-white text-decoration-none">
                                <img src="https://upload.wikimedia.org/wikipedia/commons/9/91/Icon_of_Zalo.svg" alt="Zalo">
                            </a>
                        </div>
                    </div>
                </div>
                <div class="align-items-center mt-3">
                    <a asp-controller="Appointment" asp-action="Index" class="btn-custom p-3 text-decoration-none rounded-0">
                        Book an Appointment <span class="arrow"></span>
                    </a>
                </div>
                <div class="col-md-7 mt-5">
                    <h5 class="text-white mb-2">Our Products</h5>
                    <div class="list-group list-group-flush shadow-sm">
                        <a asp-controller="Suit" asp-action="Index" class="list-group-item list-group-item-action list-group-item-nav border-bottom border-white">
                            Custom Suit
                        </a>
                        <a asp-controller="Tuxedo" asp-action="Index" class="list-group-item list-group-item-action list-group-item-nav border-bottom border-white">
                            Custom Tuxedo
                        </a>
                        <a asp-controller="Blazer" asp-action="Index" class="list-group-item list-group-item-action list-group-item-nav border-bottom border-white">
                            Custom Jackets
                        </a>
                        <a asp-controller="Coat" asp-action="Index" class="list-group-item list-group-item-action list-group-item-nav border-bottom border-white">
                            Custom Overcoats
                        </a>
                        <a asp-controller="Trousers" asp-action="Index" class="list-group-item list-group-item-action list-group-item-nav border-bottom border-white">
                            Custom Trousers
                        </a>
                        <a asp-controller="Shirt" asp-action="Index" class="list-group-item list-group-item-action list-group-item-nav border-bottom border-white">
                            Custom Shirt
                        </a>
                        <a asp-controller="Gallery" asp-action="Index" class="list-group-item list-group-item-action list-group-item-nav border-bottom border-white">
                            Customer Gallery
                        </a>
                    </div>
                </div>
                <div class="col-md-7 mt-5">
                    <div class="col-md-7">
                        <img src="/image/UNLIM-fabric-acorn.jpg" alt="UNLIM fabric collection" class="fabric-acorn" />
                        <a asp-controller="Fabrics" asp-action="Index" class="text-nowrap list-group-item-action list-group-item-nav border-bottom border-white fs-6 py-2 px-5">
                            Fabrics Collections
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-5">
            <span class="text-secondary small">
                @Html.Raw(Model.Description)
            </span>
        </div>
        <div class="mt-auto small">
            Please contact the following phone number for more details:
            <a href="tel:0989473579" class="text-danger">098 947 3579</a> or  <a href="tel:02466868107" class="text-danger">02466868107</a> <span class="text-secondary">(Open 9:00 am - 9:00 pm)</span>
        </div>
        <div class="related-products-section mt-2 pt-5 border-top border-secondary">
            <div class="live-search-box mt-3 mb-3">
                <input type="text" id="liveSearchInput" class="live-search-input" placeholder="Search..." autocomplete="off">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <div id="searchResults" class="search-results-dropdown shadow">
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fs-4 text-uppercase text-white tracking-wide mb-0">Related Products</h3>
                <div class="carousel-controls d-flex gap-2">
                    <button class="btn btn-sm btn-outline-light rounded-circle" type="button" data-bs-target="#relatedProductsCarousel" data-bs-slide="prev">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-light rounded-circle" type="button" data-bs-target="#relatedProductsCarousel" data-bs-slide="next">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>
            <div id="relatedProductsCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @{
                        var products = ViewBag.RelatedProducts as List<FashionStore.Repository.Models.Product>;
                        int chunkSize = 4;
                    }
                    @if (products != null && products.Any())
                    {
                        for (int i = 0; i < products.Count; i += chunkSize)
                        {
                            var chunk = products.Skip(i).Take(chunkSize).ToList();
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <div class="row row-cols-2 row-cols-md-4 g-3">
                                    @foreach (var item in chunk)
                                    {
                                        <div class="col">
                                            <div class="card h-100 bg-black border-secondary product-card hover-lift">
                                                <a asp-controller="Home" asp-action="Details" asp-route-slug="@item.Slug" class="text-decoration-none">
                                                    <div class="overflow-hidden">
                                                        <img src="@item.ImageUrl" class="card-img-top object-fit-cover product-img" alt="@item.ProductName" loading="lazy">
                                                    </div>
                                                    <div class="card-body text-center p-3">
                                                        <h6 class="card-title text-white text-truncate mb-1">@item.ProductName</h6>
                                                        <small class="text-secondary text-uppercase fs-7">@item.Category?.CategoryName</small>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<div class="bg-content">
    <img src="/image/suit-poket-square.jpg" alt="UNLIM Tailor Pocket Square">
    <div class="bg-content-text">
        <h2 class="bg-content-text-title">Unique handmade<br /> accessories</h2>
        <a asp-controller="Fabrics" asp-action="Index" class="px-4 py-2 bg-black text-white text-decoration-none">
            View More
        </a>
    </div>
</div>
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-dark border-secondary">
            <div class="modal-header border-0">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 overflow-hidden text-center">
                <img id="modalImage" src="" class="img-fluid" style="cursor: zoom-in; transition: transform 0.2s ease;">
            </div>
        </div>
    </div>
</div>
<a href="https://www.facebook.com/MAYDOSUITCAOCAP" target="_blank" class="messenger-circle">
    <i class="fa-brands fa-facebook-messenger"></i>
</a>
<a href="tel:0989473579" class="call-circle">
    <i class="fa-solid fa-phone"></i>
</a>
<a href="https://zalo.me/0989473579" target="_blank" class="zalo-circle">
    <img src="https://upload.wikimedia.org/wikipedia/commons/9/91/Icon_of_Zalo.svg" alt="Zalo" />
</a>
<script>
    function changeMainImage(el) {
        document.getElementById("mainImage").src = el.src;
        document.querySelectorAll(".thumb-item").forEach(x => x.classList.remove("active"));
    el.classList.add("active");
    }
</script>
