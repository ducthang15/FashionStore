@model FashionStore.Repository.Models.Product
@{
    ViewData["Title"] = Model.ProductName;
}

<div class="container-fluid product-dark py-5">
    <div class="container mt-5">
        <nav class="breadcrumb-title mb-4 small">

            <a asp-controller="Home" asp-action="Index"
               class="text-decoration-none text-light">
                Trang chủ
            </a>
            <span class="mx-2">/</span>
            <a asp-controller="Suit" asp-action="Index"
               class="text-decoration-none text-secondary text-uppercase">
                @Model.Category.CategoryName
            </a>
            <span class="mx-2">/</span>
            <span class="text-white fw-semibold text-uppercase">
                @Model.ProductName
            </span>
        </nav>
        <div class="row g-4">
            <div class="col-lg-7 d-flex">

                <div class="d-flex flex-column gap-2 me-3">
                    @foreach (var img in Model.ProductImages)
                    {
                        <img src="@img.ImageUrl"
                             onclick="changeMainImage(this)"
                           
                             width="70" height="70">
                    }
                </div>
                <div class="flex-grow-1 justify-content-center">
                    <img id="mainImage"
                         src="@Model.ImageUrl"
                         class="img-fluid rounded border">
                </div>

            </div>
            <div class="col-lg-5 product-info">
                <h4 class="fw-bold mb-2">@Model.ProductName</h4>
                <h5>Thương hiệu: @Model.Category?.CategoryName</h5><br />
                <div>Mô tả sản phẩm:</div>
                <p class="text-secondary">
                    @Html.Raw(Model.Description)
                </p>
                <div class="text-center mt-5">
                    Liên hệ: <span class="text-danger">098 947 3579</span> để biết thêm chi tiết!
                </div>

                <hr class="border-secondary">
            </div>
        </div>
    </div>
</div>
<script>
    function changeMainImage(el) {
        document.getElementById("mainImage").src = el.src;
        document.querySelectorAll(".thumb-item")
            .forEach(x => x.classList.remove("active"));
        el.classList.add("active");
    }
</script>
