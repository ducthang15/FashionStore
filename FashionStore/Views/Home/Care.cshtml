<link href="/css/site.css" rel="stylesheet" />
@{
    ViewData["Title"] = "Care & Maintenance";
    ViewData["MetaDescription"] = "Preserve the elegance of your bespoke suits with professional care. Discover sophisticated techniques for preserving suits and fine fabrics at UNLIM TAILOR.";
}
<section class="hero-section text-center">
    <div class="container">
        <h1 class="display-4">Care & Maintenance</h1>
    </div>
</section>
<div class="container text-dark mb-5">
    <div class="row">
        <div class="col-lg-12">
            <div class="policy-card p-4 mb-3">
                <h1>Guaranteed Perfect Fit</h1>
                <div class="accent-line"></div>
                <p>Each tailored suit is a unique masterpiece. We are committed to delivering absolute comfort for our customers:</p>
                <ul class="text-muted">
                    <li><strong>Lifetime alterations:</strong> Free adjustments (tightening/loosening) if your body size changes (within fabric limits).</li>
                    <li><strong>Stitching warranty:</strong> Free button replacement and stitching repairs within 12 months.</li>
                    <li><strong>Worldwide warranty:</strong> We provide product warranty support anywhere.</li>
                </ul>
            </div>
            <div class="policy-card p-4 mb-3">
                <h1>Care & Maintenance</h1>
                <div class="accent-line"></div>
                <p>To keep your suit in perfect condition over time, please note:</p>
                <p class="text-muted italic">
                    * Dry clean only on a regular basis.<br>
                    * Use a padded wooden hanger for proper support.<br>
                    * Avoid ironing at excessively high temperatures at home.
                </p>
            </div>
            <div class="container">
                <h4>For any questions, please contact us at: 098 947 3579</h4>
            </div>
        </div>
    </div>
</div>