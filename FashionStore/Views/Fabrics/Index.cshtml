@model IEnumerable<FashionStore.Repository.Models.Product>

@{
    ViewData["Title"] = "Custom Fabrics";
    ViewData["MetaDescription"] = "We have thousands of Italian and British fabric samples, trending fabrics for 2026, high-quality yarn, Italian, British and American styles, diverse, lightweight and breathable.";
    var categories = ViewBag.Categories as IEnumerable<FashionStore.Repository.Models.Category>;
}
<div class="video-bg">
    <div class="mobile-poster"></div>
</div>
<div class="position-relative overflow-hidden">
    <picture>
        <source media="(min-width: 992px)"
                srcset="/image/fabric-custom-design-unlim.jpg">
        <source media="(max-width: 991px)"
                srcset="/image/fabric-custom-design-unlim.jpg">
        <img src="/image/fabric-custom-design-unlim.jpg"
             class="img-fluid w-100"
             alt="Custom Tailored Fabrics">
    </picture>
    <div class="position-absolute top-50 start-50 translate-middle text-center text-white d-none d-md-block">
        <h1 class="title-customer-signature fw-bold d-md-block d-none">DISCOVER THE UNLIM TAILOR FABRICS COLLECTION</h1>
        <p class="fs-4 d-md-block d-none">Our thousands of fabric samples will satisfy you.</p>
    </div>
    <h3 class="position-absolute top-50 start-50 translate-middle text-center px-4 d-block d-md-none">Fabric</h3>
</div>
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var currentCategoryId = ViewBag.CurrentCategoryId as int?;
}

<nav class="container-fluid breadcrumb-style mb-4 px-0">
    <div class="d-flex d-md-flex d-none justify-content-center p-2">
        <div class="d-flex gap-2 p-2 overflow-auto">
            <a asp-controller="Home" asp-action="Index" class="breadcrumb-item-custom px-3 py-2 text-decoration-none border @(controller == "Home" ? "active" : "")">
                Home
            </a>
            @if (categories != null)
            {
                foreach (var cate in categories)
                {
                    <a asp-controller="@cate.CategoryName" asp-action="Index" class="breadcrumb-item-custom px-3 py-2 text-decoration-none border @(currentCategoryId == cate.CategoryId ? "active" : "")">
                        @cate.CategoryName
                    </a>
                }
            }
        </div>
    </div>
</nav>
<div class="container">
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            Hiện chưa có sản phẩm !
        </div>
    }
    else
    {
        <div class="row g-2 mb-4">
            @foreach (var item in Model)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="h-100 product-box">

                        <a asp-controller="Home" asp-action="Details"
                           asp-route-slug="@item.Slug"
                           class="text-decoration-none d-block">

                            <div class="product-img">
                                <img src="@item.ImageUrl"
                                     alt="@item.ProductName"
                                     loading="lazy">
                            </div>

                            <div class="card-body text-center p-2 product-info">
                                <p class="m-0">
                                    @item.ProductName
                                </p>
                                <p class="text-danger ">Contact us</p>
                            </div>

                        </a>

                    </div>
                </div>
            }
        </div>
    }
</div>
<a href="https://www.facebook.com/MAYDOSUITCAOCAP" target="_blank" class="messenger-circle d-md-none">
    <i class="fa-brands fa-facebook-messenger"></i>
</a>
<a href="tel:0989473579" class="call-circle d-md-none">
    <i class="fa-solid fa-phone"></i>
</a>
<a href="https://zalo.me/0989473579" target="_blank" class="zalo-circle d-md-none">
    <img src="https://upload.wikimedia.org/wikipedia/commons/9/91/Icon_of_Zalo.svg" alt="Zalo" />
</a>
@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination custom-pagination justify-content-center">
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-sort="@ViewBag.CurrentSort">
                        &lsaquo;
                    </a>
                </li>
            }
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-sort="@ViewBag.CurrentSort">
                        @i
                    </a>
                </li>
            }
            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-sort="@ViewBag.CurrentSort">
                        &rsaquo;
                    </a>
                </li>
            }

        </ul>
    </nav>
}