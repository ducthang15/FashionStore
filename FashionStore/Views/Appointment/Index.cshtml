@model FashionStore.Repository.Models.Appointment

@{
    ViewData["Title"] = "Make An Appointment";
    ViewData["MetaDescription"] = "Experience bespoke suit tailoring at UNLIM TAILOR. Unique designs, premium materials, and a perfect fit for the modern gentleman’s style.";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<link href="~/css/site.css" rel="stylesheet" />
<picture>
    <source media="(min-width: 992px)"
            srcset="/image/appoinment.png">
    <source media="(min-width: 576px)"
            srcset="/image/appoinment.png">
    <img src="/image/appoinment.png" class="img-fluid w-100" alt="Bespoke Tailoring">
</picture>
<div class="make-appoinment pb-4">
    <div class="container text-center fs-6 col-md-8 mt-3">
        <h1 class="fw-bold mb-3 text-center text-dark">
            Book An Appointment With Us
        </h1>
        <p class="text-dark">
            If you would like to schedule a private appointment, please fill out the information below and our consultants will respond shortly.
            Please select a time to schedule your appointment. Let us know below.
        </p>
    </div>
    <div class="container">
        <div class="row justify-content-center">
            <div class="form-book">
                <div class="text-dark">
                    <div class="row">
                        <div class="appoiment text-center">
                            <form asp-action="Book" method="post" class="container">
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-floating mb-4">
                                            <input asp-for="FullName" class="form-control rounded-1 bg-light" placeholder="Name">
                                            <label asp-for="FullName">Name *</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating mb-4">
                                            <input asp-for="PhoneNumber" class="form-control rounded-1 bg-light" placeholder="Number">
                                            <label asp-for="PhoneNumber">Phone number*</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating mb-4">
                                            <input asp-for="Address" class="form-control rounded-1 bg-light" placeholder="Address">
                                            <label asp-for="Address">Your address *(optional)</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating mb-4">
                                            <input asp-for="AppointmentDate" id="appointmentDate" type="text" class="form-control rounded-1 bg-light" placeholder="Date and time" />
                                            <label asp-for="PhoneNumber">Date and time appointment *</label>
                                            <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-12 mb-3">
                                        <textarea asp-for="Content" class="form-control rounded-0" style="height:120px" placeholder="Please specify details (style, material, occasion,...)"></textarea>
                                    </div>
                                </div>
                                <div class="d-grid d-md-block">
                                <button type="submit" class="send-btn text-white px-4 border py-3 text-uppercase">
                                        CONFIRM APPOINTMENT
                                </button>
                                </div>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<a href="https://www.facebook.com/MAYDOSUITCAOCAP" target="_blank" class="messenger-circle">
    <i class="fa-brands fa-facebook-messenger"></i>
</a>
<a href="tel:0989473579" class="call-circle">
    <i class="fa-solid fa-phone"></i>
</a>
<script>
    flatpickr("#appointmentDate", {
        enableTime: true,
        dateFormat: "Y-m-d H:i",
        time_24hr: true,
        minDate: "today"
    });
</script>
