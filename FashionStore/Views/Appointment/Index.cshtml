@model FashionStore.Repository.Models.Appointment
@using FashionStore.Repository.Models

@{
    var reviews = ViewBag.Reviews as List<CustomerReview>;
}
@{
    ViewData["Title"] = "Make An Appointment";
    ViewData["MetaDescription"] = "Experience bespoke suit tailoring at UNLIM TAILOR. Unique designs, premium materials, and a perfect fit for the modern gentleman’s style.";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<link href="~/css/site.css" rel="stylesheet" />
@section Styles {
    <link rel="stylesheet" href="~/css/landbook.css" asp-append-version="true" />
}
<!-- 1. HERO SECTION -->
<section class="hero-fullscreen">
    <div class="container text-center">
        <h6 class="text-gold tracking-widest mb-4">EST. HANOI</h6>
        <h1 class="display-2 font-serif mb-4">UNLIM TAILOR</h1>
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <p class="lead-text text-light mb-5">
                    Going far beyond the limitations of conventional menswear, we create garments that become a true extension of the wearer. Each bespoke masterpiece is meticulously handmade, designed exclusively to embody your confidence, distinction, and personal pride.
                </p>
                <div class="container text-center fs-6 col-md-8 mt-3">
                    <h1 class="mb-3 text-center font-serif">
                        Book An Appointment
                    </h1>
                </div>
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="form-book">
                            <div class="text-dark">
                                <div class="row">
                                    <div class="appoiment text-center">
                                        <form asp-action="Book" method="post" class="container">
                                            @Html.AntiForgeryToken()
                                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-floating mb-4">
                                                        <input asp-for="FullName" class="form-control rounded-1 bg-light" placeholder="Name">
                                                        <label asp-for="FullName">Name *</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-floating mb-4">
                                                        <input asp-for="PhoneNumber" class="form-control rounded-1 bg-light" placeholder="Number">
                                                        <label asp-for="PhoneNumber">Phone number*</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-floating mb-4">
                                                        <input asp-for="Address" class="form-control rounded-1 bg-light" placeholder="Address">
                                                        <label asp-for="Address">Your address *(optional)</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-floating mb-4">
                                                        <input asp-for="AppointmentDate" id="appointmentDate" type="text" class="form-control rounded-1 bg-light" placeholder="Date and time" />
                                                        <label asp-for="PhoneNumber">Date and time appointment *</label>
                                                        <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                                                    </div>
                                                </div>
                                                <div class="col-12 mb-3">
                                                    <textarea asp-for="Content" class="form-control rounded-0" style="height:120px" placeholder="Please specify details (style, material, occasion,...)"></textarea>
                                                </div>
                                            </div>
                                            <div class="d-flex flex-column flex-sm-row justify-content-center gap-4">
                                                <button type="submit" class="btn-gold-solid">
                                                    <i class="fa-solid fa-calendar-check me-2"></i> CONFIRM APPOINTMENT
                                                </button>
                                            </div>
                                        </form>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                @*                 <div class="d-flex flex-column flex-sm-row justify-content-center gap-4">
                    <a href="/Booking/Index" class="btn-gold-solid">
                        <i class="fa-solid fa-calendar-check me-2"></i> Book An Appointment
                    </a>
                    <a href="https://m.me/unlimtailor" class="btn-gold-outline">
                        A Conversation with Our Master Tailor
                    </a>
                </div> *@
            </div>
        </div>
    </div>
</section>

<!-- 2. BRAND ETHOS - TRIẾT LÝ -->
<section class="py-3">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-5">
                <img src="~/image/custom-suit-unlim-lpd.jpg" alt="Bespoke Tailoring" class="img-fluid rounded">
            </div>
            <div class="col-lg-7 mt-2">
                <h5 class="text-gold tracking-widest small">The ART OF EXCELLENCE</h5>
                <h2 class="display-5 font-serif mb-4">The Pursuit of Perfection</h2>
                <p class="mb-4 lead-text">
                    Nestled in a quiet corner of Kim Ma Street, UNLIM Tailor is where fine tailoring meets the artistry of traditional craftsmanship. We believe that a truly exceptional suit is defined not only by its outward appearance, but also by the intricate construction hidden beneath the surface. Every garment is meticulously crafted with an unwavering commitment to detail, ensuring elegance, comfort, and lasting character.
                </p>
                <p class="mb-3 lead-text ">
                    Using the traditional Full Canvas construction method—crafted entirely by hand with a horsehair canvas foundation—thousands of meticulous hand stitches are placed to sculpt and shape the chest. Over time, the jacket gradually adapts to your posture and natural movements, creating a fit that becomes increasingly personal, comfortable, and remarkably refined with every wear.
                </p>
@*                 <a href="tel:0989473579" class="text-gold text-decoration-none tracking-wide text-uppercase font-serif border-bottom border-gold">
                    Call Now <i class="fa-solid fa-arrow-right ms-2"></i>
                </a> *@
            </div>
        </div>
    </div>
</section>
<section class="testimonial-section py-3">
    <div class="testimonial-section-main container">
        <div class="text-center">
            <h6 class="text-gold text-uppercase font-serif letter-spacing">
                Client Testimonials
            </h6>
            <h2 class="display-5 testimonial-title font-serif ">
                Trusted by Gentlemen Worldwide
            </h2>
        </div>
        <div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                @if (reviews != null && reviews.Any())
                {
                    @for (int i = 0; i < reviews.Count; i++)
                    {
                        var item = reviews[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="testimonial-bg"
                                 style="background-image:url('@item.SuitImage')">
                            </div>
                            <div class="testimonial-card mt-4">
                                <img src="@item.SuitImage" class="testimonial-avatar" alt="@item.CustomerName">
                                <div>
                                    <img src="@item.AvatarImage" class="avt-customer" />
                                </div>
                                <h5 class="client-name">
                                    @item.CustomerName
                                </h5>
                                <p class="testimonial-text">
                                    "@item.ReviewContent"
                                </p>
                                <div class="stars">
                                    @for (int s = 0; s < item.Rating; s++)
                                    {
                                        <span>★</span>
                                    }
                                </div>
                                <span class="client-info">
                                    @item.Profession · @item.Country
                                </span>
                            </div>
                        </div>
                    }
                }
            </div>
            <!-- Prev -->
            <button class="carousel-control-prev" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev">
                <span class="custom-arrow">
                    <i class="fa-solid fa-chevron-left"></i>
                </span>
            </button>
            <!-- Next -->
            <button class="carousel-control-next" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next">
                <span class="custom-arrow">
                    <i class="fa-solid fa-chevron-right"></i>
                </span>
            </button>
        </div>
    </div>
</section>
<!-- 3. FABRIC COLLECTIONS - CHẤT LIỆU THƯỢNG HẠNG -->
<section class="fabric-collection py-3">
    <div class="container">
        <div class="text-center pb-4">
            <h5 class="text-gold tracking-widest mb-3 small">FABRIC COLLECTION</h5>
            <h2 class="display-5 font-serif">The Foundation of True Elegance</h2>
            <p class="col-lg-6 mx-auto mt-3 d-none d-lg-block">True sophistication begins with the finest Merino wool fibers. Explore a curated selection of world-renowned fabrics, sourced from prestigious mills and now available at UNLIM Tailor for your next bespoke creation.</p>
        </div>

        <div class="row g-2">
            <div class="col-md-6 col-lg-3">
                <div class="fabric-card">
                    <h3 class="font-serif text-light mb-3">Giorgio</h3>
                    <p class=" small mb-4">A premium wool-blend fabric engineered for impeccable drape and outstanding wrinkle resistance. Combining elegance with practicality, it is the preferred choice for business professionals who travel frequently and require a polished appearance throughout the day.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="fabric-card">
                    <h3 class="font-serif text-light mb-3">Medici</h3>
                    <p class=" small mb-4">Woven from luxurious Super 130s wool, this distinguished cloth combines a silky hand feel with remarkable structure and precision. Its clean lines and impeccable drape project an air of authority and sophistication, making it an exceptional choice for black-tie events, gala evenings, and red-carpet appearances.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="fabric-card">
                    <h3 class="font-serif text-light mb-3">Pasio</h3>
                    <p class=" small mb-4">Featuring sophisticated Windowpane checks and delicately woven Pinstripes, these fabrics strike the perfect balance between personality and refinement. Ideal for gentlemen who appreciate distinctive style while maintaining an air of effortless elegance.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="fabric-card">
                    <h3 class="font-serif text-light mb-3">Linen & Silk</h3>
                    <p class=" small mb-4">The perfect tailoring solution for tropical summers. Crafted from breathable twill-woven linen blended with natural silk fibers, this fabric offers exceptional comfort and airflow while maintaining an effortlessly refined and sophisticated appearance.</p>
                </div>
            </div>
        </div>
        <div class="text-center mt-5">
            <a href="/suit" class="btn-gold-solid">Experience the Fabrics Firsthand</a>
        </div>
    </div>
</section>
<section class="why-unlim-4">
    <div class="container">
        <div class="wu-title">
            <h3 class="display-5 font-serif">Why Do Customers Choose UNLIM Tailor?</h3>
            <p class="d-none d-lg-block">This isn't just an ordinary tailor shop — it's a place where you can create your own personal style.</p>
        </div>
        <div class="wu-grid">
            <!-- 1 -->
            <div class="wu-item">
                <div class="wu-img">
                    <img src="/image/abus-hand.png" alt="Bespoke tailoring">
                </div>
                <div class="wu-content">
                    <h3>Custom-made: The Ultimate In Personalization.</h3>
                    <p>
                        Each suit is custom-made based on actual measurements and body shape,
                        not using pre-made templates or mass-produced patterns.
                    </p>
                </div>
            </div>

            <!-- 2 -->
            <div class="wu-item">
                <div class="wu-img">
                    <img src="/image/appoinment.png" alt="Style consultation">
                </div>
                <div class="wu-content">
                    <h3>Designed to fit your lifestyle.</h3>
                    <p>
                        We don't just select models — we analyze professions like entrepreneurs, teachers, politicians, and any other field; we can cater to any environment and personality to create a unique style.
                    </p>
                </div>
            </div>

            <!-- 3 -->
            <div class="wu-item">
                <div class="wu-img">
                    <img src="/image/carousel-light-kt212.png" alt="Premium fabric">
                </div>
                <div class="wu-content">
                    <h3>Criteria Of Our Staff</h3>
                    <p>
                        Our staff has in-depth knowledge of body shapes and measurements. Our tailors are fluent in English and several other languages, making communication with you easier.
                    </p>
                </div>
            </div>

            <!-- 4 -->
            <div class="wu-item">
                <div class="wu-img">
                    <img src="/image/B5.png" alt="Handmade tailoring">
                </div>
                <div class="wu-content">
                    <h3>Lifetime Warranty - Anywhere.</h3>
                    <p>
                        Every stitch, every button, even the fabric itself is proudly backed by our global warranty.
                    </p>
                </div>
            </div>
        </div>
        <div class="text-center text-nowrap mt-4">
            <a href="https://m.me/unlimtailor" class="btn-gold-outline">
                A Conversation with Our Master Tailor
            </a>
        </div>
    </div>
</section>
<!-- 4. BESPOKE JOURNEY - QUY TRÌNH -->
<section class="let-us-you p-4">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 mb-5 mb-lg-0">
                <h5 class="text-gold tracking-widest mb-3 small">The Bespoke Journey</h5>
                <h3 class="display-5 font-serif mb-4">The Art of the Bespoke Journey</h3>
                <p class="lead-text d-none d-lg-block">A true bespoke suit requires patience. At UNLIM, the journey takes between three and four weeks, involving dozens of hours of meticulous handcraftsmanship by our most skilled artisans. Every stage is carried out with precision and care, ensuring a garment that is uniquely yours in both fit and character.</p>
            </div>
            <div class="col-lg-7 offset-lg-1">
                <div class="timeline-box">
                    <div class="timeline-step">I</div>
                    <h4 class="font-serif text-light mb-2">Consultation & Measurement</h4>
                    <p class=" small">Enjoy a glass of whisky or a cup of hot tea while meeting with our master tailor. We take the time to understand your lifestyle, personal preferences, and professional environment. More than 20 body measurements, along with unique anatomical characteristics such as sloping shoulders, a rounded back, or arm asymmetry, are carefully recorded to create a garment tailored exclusively to you.</p>
                </div>

                <div class="timeline-box">
                    <div class="timeline-step">II</div>
                    <h4 class="font-serif text-light mb-2">Preliminary Fitting (First Fitting)</h4>
                    <p class="small">Around two days later, you will attend a basted fitting. The suit, temporarily assembled with white basting stitches, allows our tailor to make precise adjustments to balance, fit, and comfort—ensuring a silhouette that is both elegant and effortless to wear.</p>
                </div>

                <div class="timeline-box">
                    <div class="timeline-step">III</div>
                    <h4 class="font-serif text-light mb-2">Attention to Detail (Second Fitting)</h4>
                    <p class=" small">The suit is now approximately 90% complete. Our master tailor carefully refines the sleeve length, trouser break, and overall drape, while ensuring the shoulders and chest fit smoothly and naturally for a polished silhouette.</p>
                </div>

                <div class="timeline-box">
                    <div class="timeline-step">IV</div>
                    <h4 class="font-serif text-light mb-2">The Final Reveal</h4>
                    <p class=" small">The final garment undergoes meticulous steam-finishing to perfect its shape and drape. Genuine horn and mother-of-pearl buttons are hand-sewn with precision, while your name is silk-embroidered inside the lining—a personal signature that marks the ownership of a truly unique bespoke masterpiece..</p>
                </div>
            </div>
        </div>
    </div>
</section>
