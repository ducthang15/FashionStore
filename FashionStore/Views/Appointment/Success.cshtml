@{
    ViewData["Title"] = "Appointment scheduled successfully";
}

<div class="success-book-customer">
    <div class="container text-center p-5">
        <div class="mx-auto bg-black opacity-75 p-3" style="max-width: 600px;">
            <i class="fa-solid fa-circle-check text-success mb-4 fs-1"></i>
            <h2 class="text-white fw-bold mb-3">APPOINTMENT SENT!</h2>
            <p class="fs-6 text-white">
                Thank you for scheduling an appointment. We will contact you by phone as soon as possible to confirm.
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light rounded-pill px-5 mt-3">
                HOME PAGE
            </a>
        </div>
    </div>
</div>