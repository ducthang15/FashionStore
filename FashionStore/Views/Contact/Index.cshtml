@model FashionStore.Repository.Models.Contact
@{
	ViewData["Title"] = "Contact UNLIM Tailor | High-End Custom Tailored Wedding Suits & Men's Vests in Hanoi";

	ViewData["MetaDescription"] = "Connect with UNLIM Tailor at 107 Kim Mã to experience premium bespoke wedding suits and men's vests. Our team of experts is ready to advise you on a unique style.";
	ViewData["MetaKeywords"] = "Contact UNLIM, bespoke wedding suit tailoring in Hanoi, high-end men's suits in Kim Ma, tuxedo tailor in Hanoi, UNLIM tailor address, schedule a suit consultation.";

}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script type="application/ld+json">
	{
	  "@@context": "https://schema.org",
	  "@@type": "ClothingStore",
	  "name": "UNLIM TAILOR",
	  "image": "https://unlimtailor.com/images/logo.png",
	  "telephone": "0989473579",
	  "email": "unlimkimma@gmail.com",
	  "address": {
		  "@@type": "PostalAddress",
		  "streetAddress": "107 Kim Ma",
		  "addressLocality": "Hà Nội",
		  "addressRegion": "Ba Đình",
		  "addressCountry": "VN"
		},},
	  "geo": {
		"@@type": "GeoCoordinates",
		"latitude": 21.033,
		"longitude": 105.85
	  },
	  "openingHoursSpecification": {
		"@@type": "OpeningHoursSpecification",
		"dayOfWeek": [
		  "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
		],
		"opens": "08:00",
		"closes": "22:00"
	  }
	}
</script>
<picture>
	<source media="(min-width: 992px)"
			srcset="/image/b8.png">
	<source media="(min-width: 576px)"
			srcset="/image/b8.png">
	<img src="/image/b8.png"
		 class="img-fluid w-100"
		 alt="Bespoke Tailoring">
</picture>
<div class="contact-page">
	<div class="container mb-4">
		@if (TempData["SuccessMessage"] != null)
		{
			<div class="alert alert-success alert-dismissible fade show" role="alert">
				<i class="fa-solid fa-check-circle me-2"></i> @TempData["SuccessMessage"]
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		}
		<div class="row mt-3">
			<div class="col-lg-6">
				<h1 class="fw-bold mb-3 text-dark">Contact Us</h1>
				<ul class="list-unstyled mb-4 fs-6">
					<li class="mb-3 text-dark"><i class="fa-solid fa-location-dot text-danger me-3"></i> <strong class="fw-bold">Address:</strong> 105 - 107 Kim Ma Street, Ba Dinh District, Hanoi</li>
					<li class="mb-3 text-dark"><i class="fa-solid fa-phone text-success me-3"></i> <strong class="fw-bold">Hotline:</strong> <a href="tel:0246 6868 107" class="text-decoration-none text-dark">0246 6868 107</a></li>
					<li class="mb-3 text-dark"><i class="fa-solid fa-envelope text-warning me-3"></i> <strong class="fw-bold">Email:</strong> unlimkimma@gmail.com</li>
					<li class="mb-3 text-dark"><i class="fa-solid fa-clock text-dark me-3"></i> <strong class="fw-bold">Working hours: </strong> Monday - Sunday: 9 am to 9 pm</li>
				</ul>
				<div class="ratio ratio-16x9 rounded-4 overflow-hidden">
					<iframe src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d7448.05183271988!2d105.82533600000001!3d21.031649!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3135ab13c6cba743%3A0x4f96a3971ba92e1f!2sUNLIM%20Tailor%20-%20Bespoke%20suit%20H%C3%A0%20N%E1%BB%99i!5e0!3m2!1svi!2sus!4v1774840677856!5m2!1svi!2sus" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
				</div>
			</div>
			<div class="col-lg-6">
				<div class="card border mt-4 p-4">
					<h3 class="fw-medium text-center">Send us a message </h3>
					<p class="text-center">We will contact you as soon as possible!</p>
					<form asp-action="Send" method="post">
						<div class="form-floating">
							<input asp-for="FullName" class="form-control" placeholder="Name" />
							<label asp-for="FullName">Name</label>
							<span asp-validation-for="FullName" class="text-danger small ms-2"></span>
						</div>

						<div class="row">
							<div class="col-md-6">
								<div class="form-floating">
									<input asp-for="Email" class="form-control" placeholder="Email" />
									<label asp-for="Email">Email</label>
									<span asp-validation-for="Email" class="text-danger small ms-2"></span>
								</div>
							</div>
							<div class="col-md-6">
								<div class="form-floating">
									<input asp-for="Phone" class="form-control" placeholder="SĐT" />
									<label asp-for="Phone">Phone number</label>
									<span asp-validation-for="Phone" class="text-danger small ms-2"></span>
								</div>
							</div>
						</div>

						<div class="form-floating">
							<textarea asp-for="Message" class="form-control" placeholder="Nội dung" style="height: 180px;"></textarea>
							<label asp-for="Message">Which item are you looking for, sir?</label>
							<span asp-validation-for="Message" class="text-danger small ms-2"></span>
						</div>

						<div class="text-center d-grid d-md-block">
							<button type="submit" class="contact-send fs-6 px-4 py-3 text-white border">
								Send
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
<a href="https://www.facebook.com/MAYDOSUITCAOCAP" target="_blank" class="messenger-circle">
	<i class="fa-brands fa-facebook-messenger"></i>
</a>
<a href="tel:0989473579" class="call-circle">
	<i class="fa-solid fa-phone"></i>
</a>