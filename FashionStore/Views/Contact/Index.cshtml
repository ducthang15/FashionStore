@model FashionStore.Repository.Models.Contact
@{
    ViewData["Title"] = "Contact UNLIM Tailor | High-End Custom Tailored Wedding Suits & Men's Vests in Hanoi";

    ViewData["MetaDescription"] = "Connect with UNLIM Tailor at 107 Kim Mã to experience premium bespoke wedding suits and men's vests. Our team of experts is ready to advise you on a unique style.";
    ViewData["MetaKeywords"] = "Contact UNLIM, bespoke wedding suit tailoring in Hanoi, high-end men's suits in Kim Ma, tuxedo tailor in Hanoi, UNLIM tailor address, schedule a suit consultation.";

}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script type="application/ld+json">
        {
      "@@context": "https://schema.org",
      "@@type": "ClothingStore",
      "name": "UNLIM TAILOR",
      "image": "https://unlimtailor.com/images/logo.png",
      "url": "https://unlimtailor.com",
      "telephone": "0989473579",
      "email": "unlimkimma@gmail.com",
      "address": {
      "@@type": "PostalAddress",
      "streetAddress": "107 Kim Ma",
      "addressLocality": "Hà Nội",
      "addressRegion": "Ba Đình",
      "addressCountry": "VN"
    },
      "geo": {
        "@@type": "GeoCoordinates",
        "latitude": 21.03165,
        "longitude": 105.82275
      },
      "openingHoursSpecification": {
        "@@type": "OpeningHoursSpecification",
        "dayOfWeek": [
          "Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"
        ],
        "opens": "09:00",
        "closes": "21:00"
      }
    }
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;1,400&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">

<style>
    .journey-contact {
        font-family: 'Montserrat', sans-serif;
        color: #2c3e50;
        background-color: #ffffff;
    }

    .serif-title {
        font-family: 'Lora', serif;
        color: #1a252f;
    }

    .text-copper {
        color: #b87333;
    }

    .bg-light-cream {
        background-color: #faf9f7;
    }

    .contact-hero {
        position: relative;
        min-height: 400px;
        background-image: url('/image/107-KimMa-BaDinh-Hanoi.jpg');
        background-size: cover;
        background-position: center 30%;
    }

        .contact-hero::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(26, 37, 47, 0.4);
        }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .process-step {
        padding: 20px 10px;
        border-right: 1px solid #eaeaea;
        transition: transform 0.3s ease;
    }

        .process-step:last-child {
            border-right: none;
        }

    .step-number {
        font-family: 'Lora', serif;
        font-size: 3rem;
        color: #f1e9e3;
        margin-bottom: -20px;
        position: relative;
        z-index: 1;
    }

    .step-title {
        position: relative;
        z-index: 2;
        font-weight: 500;
        letter-spacing: 1px;
    }

    /* Form liên hệ thanh thoát */
    .elegant-form .form-control {
        border: none;
        border-bottom: 1px solid #d1d1d1;
        border-radius: 0;
        padding: 12px 0;
        background: transparent;
        font-family: 'Montserrat', sans-serif;
        font-weight: 300;
        transition: all 0.4s;
    }

        .elegant-form .form-control:focus {
            border-bottom-color: #b87333;
            box-shadow: none;
        }

    .elegant-form label {
        padding-left: 0;
        color: #7f8c8d;
        font-family: 'Lora', serif;
        font-style: italic;
    }

    /* Nút bấm tối giản */
    .btn-copper {
        background-color: #b87333;
        color: #fff;
        border: 1px solid #b87333;
        border-radius: 0;
        padding: 15px 40px;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-size: 0.85rem;
        transition: all 0.3s;
    }

        .btn-copper:hover {
            background-color: transparent;
            color: #b87333;
        }
</style>

<div class="journey-contact">
    <section class="py-3 bg-light-cream border-bottom">
        <div class="container">
            <div class="text-center mb-2">
                <h2 class="serif-title">Contact Us</h2>
                <p class="text-muted fw-light">Please leave your contact information so we can serve you as quickly as possible. Just fill in a few details and we will contact you within 15 minutes.</p>
                <div style="width: 50px; height: 1px; background-color: #b87333; margin: 0 auto;"></div>
            </div>

            <div class="row text-center g-0">
                <div class="col-md-4 process-step">
                    <h4 class="step-title text-uppercase fs-6 mt-3">The Showroom</h4>
                    <p class="text-muted small fw-light mt-3 px-3">
                    <p class="fw-light mb-1 mt-2">105 - 107 Kim Ma Street</p>
                    <p class="fw-light mb-0">Ba Dinh Ward, HaNoi</p>.</p>
                </div>
                <div class="col-md-4 process-step">
                    <h4 class="step-title text-uppercase fs-6 mt-3">Contact</h4>
                    <p class="fw-light mb-1 mt-2"><a href="tel:02466868107" class="text-decoration-none text-dark">Hot line: 0246 6868 107</a></p>
                    <p class="fw-light mb-0"><a href="mailto:unlimkimma@gmail.com" class="text-decoration-none text-dark">unlimkimma@gmail.com</a></p>
                </div>
                <div class="col-md-4 process-step">
                    <h4 class="step-title text-uppercase fs-6 mt-3">Opening Hours</h4>
                    <p class="fw-light mb-0 mt-2">Monday – Sunday<br>9:00 AM – 9:00 PM</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Form & Thông tin liên hệ -->
    <section class="py-2 my-md-4">
        <div class="container">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success rounded-0 bg-white border border-success text-center mb-5" role="alert">
                    <i class="fa-solid fa-check text-success me-2"></i> @TempData["SuccessMessage"]
                </div>
            }
            <div class="row justify-content-between">
                <div class="col-lg-5">
                    <div class="contact-hero d-flex align-items-center justify-content-center text-center">
                        <div class="hero-content text-white container d-none d-lg-block">
                        </div>
                    </div>
                </div>
                <div class="col-lg-7">
                    <form asp-action="Send" method="post" class="elegant-form">
                        @Html.AntiForgeryToken()
                        <div class="row">
                            <h4 class="step-title serif-title">Fill in the information</h4>
                            <div class="col-md-6 mb-2">
                                <div class="form-floating">
                                    <input asp-for="FullName" class="form-control" placeholder="Name" />
                                    <label asp-for="FullName">First & Last Name *</label>
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-2">
                                <div class="form-floating">
                                    <input asp-for="Phone" class="form-control" placeholder="Phone" />
                                    <label asp-for="Phone">Phone Number *</label>
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-2">
                            <input asp-for="Email" class="form-control" placeholder="Email" />
                            <label asp-for="Email">Email Address</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-5">
                            <textarea asp-for="Message" class="form-control" placeholder="Message" style="height: 120px;"></textarea>
                            <label asp-for="Message">How can we assist you, sir?</label>
                            <span asp-validation-for="Message" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-copper w-100 fw-medium">
                            Send Request
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>
    <section class="container">
        <div class="mb-3">
            <div style="height: 370px; width: 100%;">
                <iframe src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d7448.05183271988!2d105.82533600000001!3d21.031649!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3135ab13c6cba743%3A0x4f96a3971ba92e1f!2sUNLIM%20Tailor%20-%20Bespoke%20suit%20H%C3%A0%20N%E1%BB%99i!5e0!3m2!1svi!2sus!4v1774840677856!5m2!1svi!2sus" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>
    </section>
</div>
<style>
    .float-contact {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 999;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .float-icon {
        width: 45px;
        height: 45px;
        background: #ffffff;
        border: 1px solid #b87333;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #b87333;
        text-decoration: none;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        transition: 0.3s;
    }

        .float-icon:hover {
            background: #b87333;
            color: #fff;
            transform: translateY(-3px);
        }
</style>
<div class="float-contact">
    <a href="https://www.facebook.com/MAYDOSUITCAOCAP" target="_blank" class="float-icon"><i class="fa-brands fa-facebook-messenger fs-5"></i></a>
    <a href="tel:0989473579" class="float-icon"><i class="fa-solid fa-phone fs-5"></i></a>
    <a href="https://zalo.me/0989473579" target="_blank" class="float-icon">
        <img src="https://upload.wikimedia.org/wikipedia/commons/9/91/Icon_of_Zalo.svg" alt="Zalo" style="width: 20px; filter: grayscale(100%) sepia(100%) hue-rotate(340deg) saturate(500%) contrast(1);" />
    </a>
</div>