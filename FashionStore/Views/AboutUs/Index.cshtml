@{
    ViewData["Title"] = "About Us";
    ViewData["MetaDescription"] = "Our clients are politicians, businesspeople, and influencers – individuals who are not only successful in their careers but also represent the image of an entire group, organization, or nation. We understand that every time you appear before the public, the media, or partners, your image must project composure, dignity, and class.";
}
@section Styles {
    <link rel="stylesheet" href="~/css/aboutus.css" asp-append-version="true" />
}
    <div class="fabric-texture"></div>
    <section class="hero-pattern">
        <div class="hero-visual">
            <img src="/image/banner-main-project.png" alt="Bespoke Tailoring">
            <div class="pattern-lines">
                <div class="line h1"></div>
                <div class="line h2"></div>
                <div class="line v1"></div>
                <div class="line v2"></div>
                <div class="line d1"></div>
            </div>
        </div>
        <div class="hero-copy">
            <div class="brand-mark">Maison UNLIM</div>
            <h1>
                The Art of<br>
                <em>Bespoke</em> Tailoring
            </h1>
            <p class="hero-description">
                @ViewData["MetaDescription"]
            </p>
            <div class="hero-cta-group">
                <a href="#story" class="btn-lux primary">
                    Discover More <span class="arrow">→</span>
                </a>
                <a asp-controller="Contact" asp-action="Index" class="btn-lux secondary">
                    Request Consultation
                </a>
            </div>
        </div>
    </section>

    <!-- ==================== FABRIC SWATCH STRIP ==================== -->
    <div class="swatch-strip">
        <div class="swatch-item">
            <div class="fabric-sample">
                <img src="/image/drago-in-beilla.jpg" alt="Italian Wool">
            </div>
            <div class="swatch-name">Drago Lanificio</div>
            <div class="swatch-origin">Biella, Italy</div>
        </div>
        <div class="swatch-item">
            <div class="fabric-sample">
                <img src="/image/FLANNEL.jpg" alt="English Flannel">
            </div>
            <div class="swatch-name">Flannel</div>
            <div class="swatch-origin">Biella, Italy</div>
        </div>
        <div class="swatch-item">
            <div class="fabric-sample">
                <img src="/image/passio-in-korea.jpg" alt="Cashmere">
            </div>
            <div class="swatch-name">Pasio Lanificio</div>
            <div class="swatch-origin">Korea, KR</div>
        </div>
        <div class="swatch-item">
            <div class="fabric-sample">
                <img src="/image/LINEN.jpg" alt="Linen">
            </div>
            <div class="swatch-name">Irish Linen</div>
            <div class="swatch-origin">Donegal, Ireland</div>
        </div>
    </div>
    <!-- ==================== OUR STORY – MAGAZINE SPREAD ==================== -->
    <section id="story" class="story-spread">
        <div class="spread-container mt-3">
            <div class="spread-image-side">
                <img src="/image/imgtext_1_img.jpg" alt="Bespoke Suit Detail" class="main-image">
                <div class="accent-box">
                </div>
            </div>
            <div class="spread-text-side">
                <span class="ui-label">Our Heritage</span>
                <h2>UNLIM Tailor<br>Tailoring Class</h2>
                <p>Since establishing the UNLIM Tailor brand, we have been committed to more than simply tailoring a suit; we aspire to create a refined presence for individuals who carry great responsibility.</p>
                <p>Our clients include politicians and business leaders — individuals who represent not only themselves but entire organizations and nations. Every appearance must embody composure, dignity, and distinction.</p>
                <div class="thread-quote">
                    "Each garment is a dialogue between tradition and the individual."
                </div>
                <p>Each suit is meticulously handcrafted and fully personalized. We operate in a private, discreet environment — because elegance and confidentiality are essential to the elite. Fabrics are sourced from prestigious suppliers in Italy and England.</p>
            </div>
        </div>
    </section>
    <!-- ==================== CRAFT SHOWCASE – HORIZONTAL SCROLL ==================== -->
<section class="container craft-showcase py-5">
    <div class="showcase-header text-center mb-5">
        <span class="ui-label">The Process</span>
        <h2>Our Journey</h2>
    </div>
    <div id="journeyCarousel" class="carousel slide" data-bs-ride="false">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <div class="row g-2">
                    <div class="col-12 col-md-4 ">
                        <div class="craft-card">
                            <div class="card-image-wrap">
                                <img src="/image/B1 (2).png" alt="">
                            </div>
                            <div class="card-body text-center">
                                <h4>Consultation</h4>
                                <p>Design consultation: the first chapter in shaping personal identity and elegant style.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4 ">
                        <div class="craft-card">
                            <div class="card-image-wrap">
                                <img src="/image/B2 (2).png" alt="">
                            </div>
                            <div class="card-body text-center">
                                <h4>Measurements</h4>
                                <p>Meticulous stitching and precise measurements: the foundation for a perfect suit.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 ">
                        <div class="craft-card">
                            <div class="card-image-wrap">
                                <img src="/image/B3.jpg" alt="">
                            </div>
                            <div class="card-body text-center">
                                <h4>Fabric Selection</h4>
                                <p>We select only the finest fabrics from thousands of renowned fabric samples worldwide.</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="carousel-item">
                <div class="row g-4">
                    <div class="col-12 col-md-4">
                        <div class="craft-card">
                            <div class="card-image-wrap">
                                <img src="/image/B4.jpg" alt="">
                            </div>
                            <div class="card-body text-center">
                                <h4>Fitting & Editing</h4>
                                <p>The perfect outfits are created by the most skilled and excellent tailors we have.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 ">
                        <div class="craft-card">
                            <div class="card-image-wrap">
                                <img src="/image/B5.png" alt="">
                            </div>
                            <div class="card-body text-center">
                                <h4>Completion</h4>
                                <p>A moment of pride, where the art of craftsmanship meets timeless values.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 ">
                        <div class="craft-card">
                            <div class="card-image-wrap">
                                <img src="/image/care-and-maintenance.jpg" alt="">
                            </div>
                            <div class="card-body text-center">
                                <h4>Care & Maintenance</h4>
                                <p>Preserving the elegance and longevity of your bespoke garments.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#journeyCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#journeyCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</section>
    <!-- ==================== PILLARS – THREE COLUMN ELEVATED ==================== -->
    <section class="pillars-elevated">
        <div class="section-ornament">
        <span class="ui-label">Our Values</span>
        </div>
        <h2 class="section-title">The Three Pillars</h2>
        <div class="pillars-trio">
            <div class="pillar-item-elevated">
                <div class="pillar-icon-ring">
                    <img src="/image/banmay.png" alt="Precision">
                </div>
                <h4>Precision Craft</h4>
                <p>Tailoring built on dedication and artisanal mastery, passed down through generations.</p>
            </div>
            <div class="pillar-item-elevated">
                <div class="pillar-icon-ring">
                    <img src="/image/vector-kim.png" alt="Fit">
                </div>
                <h4>Modern Fit</h4>
                <p>Designed for the way a gentleman moves—effortless, confident, and distinguished.</p>
            </div>
            <div class="pillar-item-elevated">
                <div class="pillar-icon-ring">
                    <img src="/image/vector-day.png" alt="Customization">
                </div>
                <h4>Unlimited Customization</h4>
                <p>Your vision, limitless choices. Every detail reflects your personal narrative.</p>
            </div>
        </div>
        <div class="text-center mt-3">
        <a asp-controller="Appointment" asp-action="Index" class="btn-lux cream">
            Book an Appointment <span class="arrow">→</span>
        </a>
        </div>
    </section>

    <!-- ==================== CRAFTSMANSHIP – INTERLOCKING PANELS ==================== -->
    <section class="craft-interlock">
        <div class="interlock-panel">
            <div class="interlock-image">
                <img src="/image/abus-vest.png" alt="Waistcoat detail">
                <div class="stitch-detail top-left"></div>
            </div>
            <div class="interlock-text">
            <span class="tag font-serif">Identity</span>
                <h3>The Identity of the Wearer</h3>
            <p>
                The first and most important value of a suit is its ability to express the wearer's personal style and identity.
                It's often said that "clothing is a person's second language," and nothing is truer than when a suit or tuxedo becomes a reflection of each individual's personality and style.
                From choosing colors that reflect a strong personality to selecting a style that demonstrates meticulousness, every detail in a suit is a statement about oneself.
                This ensures that every gentleman, when wearing a suit, leaves a lasting impression, highlighting their beauty and confidence.
            </p>
            </div>
        </div>
        <div class="interlock-panel reverse">
            <div class="interlock-image">
                <img src="/image/abus-hand.png" alt="Hand stitching detail">
                <div class="stitch-detail bottom-right"></div>
            </div>
            <div class="interlock-text">
                <span class="tag">Dedication</span>
                <h3>The Meticulousness of a Brand</h3>
            <p>
                Pouring its heart and soul into serving those who cherish refined beauty, Unlim is far more than a mere destination for bespoke tailoring; 
                it is a sanctuary that honors every stitch as a solemn vow to perfection. Unlim Tailor’s meticulousness eschews superficial ostentation, residing instead within the subtle nuances of the fabric 
                itself—where body measurements, the exquisite drape of a lapel, and the proud curve of a shoulder are all treated with the utmost care, guided by a superior aesthetic vision and the masterful hands of skilled artisans. 
                Standing firm amidst the shifting tides of fleeting trends, Unlim Tailor transforms unwavering exacting standards into a language of absolute luxury—a realm where dedicated passion blossoms into heritage, and timeless, impeccable beauty finds its voice in every sartorial masterpiece.
            </p>
        </div>
        </div>
    </section>

    <!-- ==================== CTA – TAILOR'S CHALK ==================== -->
    <section class="cta-chalk">
        <div class="chalk-mark">By Appointment Only</div>
        <h2>Begin Your Bespoke Journey</h2>
        <p>We invite you to experience the discretion, craftsmanship, and personal attention that define the UNLIM Tailor tradition.</p>
        <a asp-controller="Appointment" asp-action="Index" class="btn-lux cream">
           Book an Appointment <span class="arrow">→</span>
        </a>
    </section>

    <!-- ==================== FLOATING CONTACT ==================== -->
    <div class="contact-refined">
        <a href="https://www.facebook.com/MAYDOSUITCAOCAP" target="_blank" title="Messenger">
            <i class="fa-brands fa-facebook-messenger"></i>
        </a>
        <a href="tel:0989473579" title="Call">
            <i class="fa-solid fa-phone"></i>
        </a>
    <a href="https://wa.me/84989473579" title="Call-whatsapp">
        <i class="fa-brands fa-whatsapp"></i></a>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });
    </script>