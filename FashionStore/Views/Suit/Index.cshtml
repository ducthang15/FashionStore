@model IEnumerable<FashionStore.Repository.Models.Product>

@{
    ViewData["Title"] = "Custom Suit";
}
<div class="video-bg">
    <video autoplay muted loop playsinline>
        <source src="~/image/clip-product.mp4" type="video/mp4">
    </video>
</div>
<div class="banner-wrapper bg-image mb-5">
    <img src="~/image/accesory.png" alt="accessories" />
</div>

<div class="container">
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            Hiện chưa có sản phẩm.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="product-box">
                        <a asp-controller="Home" asp-action="Details" asp-route-slug="@item.Slug">
                            <div class="product-img">
                                <img src="@item.ImageUrl" alt="@item.ProductName" class="object-fit-cover">
                            </div>
                            <div class="product-info">
                                <p>@item.ProductName</p>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>