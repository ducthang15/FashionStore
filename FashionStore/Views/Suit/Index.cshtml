@model IEnumerable<FashionStore.Repository.Models.Product>

@{
    ViewData["Title"] = "Bộ Sưu Tập Suit Danh Tiếng";
}

<div class="p-5 text-center bg-image mb-4 text-white"
     style="background-image: url('https://www.rightmanapparel.com/img/inner-banner.jpg'); background-size: cover; background-position: center;">
    <div class="mask">
    </div>
</div>

<div class="container py-5">
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            Hiện chưa có sản phẩm.
        </div>
    }
    else
    {
        <div class="row g-2">
            @foreach (var item in Model)
            {
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="product-box">
                        <a asp-controller="Home" asp-action="Details" asp-route-slug="@item.Slug">
                            <div class="product-img">
                                <img src="@item.ImageUrl" alt="@item.ProductName" class="object-fit-cover">
                            </div>
                            <div class="product-info">
                                <p>@item.ProductName</p>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>