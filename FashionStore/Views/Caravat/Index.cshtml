@model IEnumerable<FashionStore.Repository.Models.Product>

@{
    ViewData["Title"] = "Thế Giới caravat";
}

<div class="alert alert-dark text-center text-white p-5 mb-4">
    <h1 class="display-4 fw-bold">Caravat</h1>
    <p>Sang trọng - Đẳng cấp - Thời thượng</p>
</div>

<div class="row row-cols-1 row-cols-md-4 g-2">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 product-card">
                <a asp-controller="Home" asp-action="Details" asp-route-slug="@item.Slug">

                    <div class="product-img">
                        <img src="@item.ImageUrl" alt="@item.ProductName">
                    </div>

                </a>

                <div class="card-body text-center product-info">
                    <h5 class="card-title text-truncate">@item.ProductName</h5>
                </div>
            </div>
        </div>
    }
</div>