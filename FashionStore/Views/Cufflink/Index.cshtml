@model IEnumerable<FashionStore.Repository.Models.Product>

@{
    ViewData["Title"] = "Bộ Sưu Tập Tkhuy cufflinks";
}

<div class="p-5 text-center bg-image mb-4 text-white"
     style="background-image: url('https://images.unsplash.com/photo-1584917865442-de89df76afd3?q=80&w=1200&auto=format&fit=crop'); background-size: cover; background-position: center;">
    <div class="mask" style="background-color: rgba(0, 0, 0, 0.6); padding: 50px;">
        <h1 class="display-4 fw-bold"> GIÀY DA</h1>
        <p class="fs-4">Phụ kiện không thể thiếu cho phong cách lịch lãm</p>
    </div>
</div>

<div class="container">
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">Hiện chưa có sản phẩm túi xách nào. Vui lòng quay lại sau!</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-4 g-2">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 product-box border-2">
                        <a asp-controller="Home" asp-action="Details" asp-route-slug="@item.Slug">

                            <div class="product-img">
                                <img src="@item.ImageUrl" alt="@item.ProductName" class="object-fit-cover">
                            </div>

                        </a>

                        <div class="card-body text-center product-info">
                            <h5 class="card-title text-truncate">@item.ProductName</h5>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>