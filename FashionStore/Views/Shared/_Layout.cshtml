<!DOCTYPE html>
<html lang="vi">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Phụ Kiện Thời Trang</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
	<link rel="stylesheet" href="~/css/site.css" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
	<nav class="navbar navbar-expand-lg navbar-dark fixed-top luxury-nav">
		<div class="container position-relative">
			<button class="navbar-toggler d-xl-none border-0 text-white navbar-toggler-icon" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu">
			</button>
			<ul class="navbar-nav d-none d-xl-flex">
				<li class="nav-item">
					<a class="nav-link text-white" asp-controller="AboutUs" asp-action="Index">About us</a>
				</li>
				<li>
					<a class="nav-link text-white" asp-controller="Blog" asp-action="Index">Blog</a>
				</li>
				<li class="nav-item">
					<a class="nav-link text-white" asp-controller="Contact" asp-action="Index">Contact</a>
				</li>
				<li class="nav-item">
					<a class="nav-link text-white" asp-controller="Gallery" asp-action="Index">Customer</a>
				</li>
				<li class="nav-item dropdown">
					<a class="nav-link dropdown-toggle text-white" href="#" id="accessoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
						Our Process
					</a>
					<ul class="dropdown-menu">
						<li>
							<a class="dropdown-item" asp-controller="Blog" asp-action="TailoringProcess">
								Tailoring process
							</a>
						</li>
						<li>
							<a class="dropdown-item" asp-controller="Blog" asp-action="TailoringAtHome">
								Tailoring at home
							</a>
						</li>
						<li>
							<a class="dropdown-item" asp-controller="Blog" asp-action="OnlineTailoring">
								Online tailoring
							</a>
						</li>
						<li>
							<a class="dropdown-item" asp-controller="Blog" asp-action="TailoringUniforms">
								Tailoring uniforms
							</a>
						</li>
						<li>
							<a class="dropdown-item" asp-controller="Blog" asp-action="ShuttleService">
								Shuttle service
							</a>
						</li>
					</ul>
				</li>
			</ul>
			<a class="navbar-brand position-absolute top-50 start-50 translate-middle fw-bold fs-3"
			   asp-controller="Home" asp-action="Index">
				TAILORING
			</a>
			<ul class="navbar-nav d-none d-xl-flex ms-auto align-items-center">
				<li class="nav-item dropdown">
					<a class="nav-link dropdown-toggle text-white" href="#" id="accessoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
						Accessories
					</a>
					<ul class="dropdown-menu">
						<li>
							<a class="dropdown-item" asp-controller="Caravat" asp-action="Index">
								Caravat
							</a>
						</li>
						<li>
							<a class="dropdown-item" asp-controller="Cufflink" asp-action="Index">
								Cufflinks
							</a>
						</li>
						<li>
							<a class="dropdown-item" asp-controller="Shoe" asp-action="Index">
								Shoe
							</a>
						</li>
					</ul>
				</li>
				<li class="nav-item dropdown">
					<a class="nav-link dropdown-toggle text-white" href="#" id="accessoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
						Product
					</a>
					<ul class="dropdown-menu">
						<li>
							<a class="dropdown-item" asp-controller="Suit" asp-action="Index">Suit</a>
						</li>
						<li>
							<a class="dropdown-item" asp-controller="Fabric" asp-action="Index">
								Fabric
							</a>
						</li>
					</ul>
				</li>
				<li class="nav-item">
					<a class="nav-link text-white" asp-controller="Appointment" asp-action="Index">Make an appointment</a>
				</li>
				<li class="nav-item dropdown">
					<a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
						<i class="fa-regular fa-user"></i>
					</a>
					<ul class="dropdown-menu dropdown-menu-end">
						@if (User.Identity.IsAuthenticated)
						{
							<li><span class="dropdown-item-text">Xin chào @User.Identity.Name</span></li>
							<li><a class="dropdown-item" asp-controller="Account" asp-action="Logout">Đăng xuất</a></li>
						}
						else
						{
							<li><a class="dropdown-item" asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
							<li><a class="dropdown-item" asp-controller="Account" asp-action="Register">Đăng ký</a></li>
						}
					</ul>
				</li>
				@* <li class="nav-item">
					<a asp-controller="Cart" asp-action="Index" class="nav-link position-relative">
						<i class="fa-solid fa-bag-shopping"></i>
						<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
							0
						</span>
					</a>
				</li> *@
			</ul>
		</div>
	</nav>
	<div class="main-fashion">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	<footer class="footer-bg text-white">
		<div class="container">
			<div class="row">
				<div class="col-md-3 mb-3">
					<h5 class="text-uppercase fw-bold mb-3">UNLIM TAILOR</h5>
					<p>We don't wish to have many customers, but we try our best to have customers for life</p>
					<p><i class="fa-solid fa-location-dot me-2"></i> Hà Nội, Việt Nam</p>
					<p><i class="fa-solid fa-phone me-2"></i> 0987.654.321</p>
				</div>
				<div class="col-md-3 mb-3">
					<h5 class="text-uppercase fw-bold mb-3">How May We Help You?</h5>
					<ul class="list-unstyled">
						<li><a href="#" class="text-white text-decoration-none mb-2 d-block">Trang chủ</a></li>
						<li><a href="#" class="text-white text-decoration-none mb-2 d-block">Giới thiệu</a></li>
						<li><a href="#" class="text-white text-decoration-none mb-2 d-block">Chính sách đổi trả</a></li>
						<li><a href="#" class="text-white text-decoration-none d-block">Liên hệ</a></li>
					</ul>
				</div>
				<div class="col-md-3 mb-3">
					<h5 class="text-uppercase fw-bold mb-3">About us</h5>
					<ul class="list-unstyled">
						<li><a href="#" class="text-white text-decoration-none mb-2 d-block">Liên hệ</a></li>
						<li><a href="#" class="text-white text-decoration-none mb-2 d-block">Đặt lich hẹn</a></li>
						<li><a href="#" class="text-white text-decoration-none mb-2 d-block">Sản phẩm</a></li>
						<li><a href="#" class="text-white text-decoration-none mb-2 d-block">FAQs</a></li>
						<li><a href="#" class="text-white text-decoration-none mb-2 d-block">Đối tác</a></li>
						<li><a href="#" class="text-white text-decoration-none mb-2 d-block">Tuyển dụng</a></li>
					</ul>
				</div>
				<div class="col-md-3 mb-3">
					<h5 class="text-uppercase fw-bold mb-3">Flow us</h5>
					<div>
						<a href="#" class="btn btn-outline-light me-2 "><i class="fa-brands fa-facebook-f"></i></a>
						<a href="#" class="btn btn-outline-light me-2 "><i class="fa-brands fa-instagram"></i></a>
						<a href="#" class="btn btn-outline-light me-2 "><i class="fa-brands fa-tiktok"></i></a>
					</div>
					<div class="mt-3">
						<p class="small text-white">Đăng ký nhận tin khuyến mãi</p>
						<div class="input-group mb-3">
							<input type="text" class="form-control" placeholder="Email...">
							<button class="btn btn-warning" type="button">Send</button>
						</div>
					</div>
				</div>
			</div>
			<div class="footer_content-bottom-wrapper page-width">
				<div class="footer_column footer_column-info">
					<div class="footer_payment">
						<span class="visually-hidden">Payment methods</span>
						<ul class="list list-payment" role="list">
							<li class="list-payment_item">
								<img src="//theme.hstatic.net/200000759169/1001361744/14/en_owinfothanhtoanicon2.png?v=1027" loading="lazy">
							</li>
							<li class="list-payment_item">
								<img src="//theme.hstatic.net/200000759169/1001361744/14/en_owinfothanhtoanicon5.png?v=1027" loading="lazy">
							</li>

							<li class="list-payment_item">
								<img src="//theme.hstatic.net/200000759169/1001361744/14/en_owinfothanhtoanicon10.png?v=1027" loading="lazy">
							</li>
						</ul>
					</div>
				</div>
			</div>
			<hr class="border-secondary">
			<div class="text-center small text-white">
				&copy; 2026 Unlim. All rights reserved. Designed by Ducthang
			</div>
		</div>
	</footer>
	<div class="offcanvas offcanvas-start luxury-offcanvas" tabindex="-1" id="mobileMenu">
		<div class="offcanvas-header">
			<h5 class="fw-bold">TAILORING</h5>
			<button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
		</div>
		<div class="offcanvas-body">
			<ul class="nav flex-column gap-3 text-uppercase">

				<li><a class="nav-link" asp-controller="AboutUs" asp-action="Index">About us</a></li>
				<li><a class="nav-link" asp-controller="Blog" asp-action="Index">Blog</a></li>
				<li><a class="nav-link" asp-controller="Contact" asp-action="Index">Contact</a></li>
				<li><a class="nav-link" asp-controller="Customer" asp-action="Index">Customer</a></li>
				<li class="fw-bold">Our Process</li>
				<li class="ps-3"><a class="nav-link" asp-controller="Blog" asp-action="TailoringProcess">Tailoring process</a></li>
				<li class="ps-3"><a class="nav-link" asp-controller="Blog" asp-action="TailoringAtHome">Tailoring at home</a></li>
				<li class="ps-3"><a class="nav-link" asp-controller="Blog" asp-action="OnlineTailoring">Online tailoring</a></li>
				<li class="ps-3"><a class="nav-link" asp-controller="Blog" asp-action="TailoringUniforms">Tailoring uniforms</a></li>
				<li class="ps-3"><a class="nav-link" asp-controller="Blog" asp-action="ShuttleService">Shuttle service</a></li>
				<li><a class="nav-link fw-bold" asp-controller="Appointment" asp-action="Index">Make an appointment</a></li>
				<!-- USER -->
				@if (User.Identity.IsAuthenticated)
				{
					<li class="text-muted ps-1">Xin chào @User.Identity.Name</li>
					<li><a class="nav-link" asp-controller="Account" asp-action="Logout">Đăng xuất</a></li>
				}
				else
				{
					<li><a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
					<li><a class="nav-link" asp-controller="Account" asp-action="Register">Đăng ký</a></li>
				}
@* 				<li>
					<a asp-controller="Cart" asp-action="Index" class="nav-link d-flex align-items-center gap-2">
						<i class="fa-solid fa-bag-shopping"></i> Cart
					</a>
				</li> *@
			</ul>
		</div>

	</div>
	<script src="~/js/site.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>