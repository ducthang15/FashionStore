@model IEnumerable<FashionStore.Repository.Models.Product>

@{
	ViewData["Title"] = "Custom Mangto";
}
<div class="video-bg">
	<video autoplay muted loop playsinline>
		<source src="~/image/clip-product.mp4" type="video/mp4">
	</video>
	<div class="mobile-poster"></div>
</div>
<div class="banner-wrapper bg-image mb-5">
	<img src="~/image/accesory.png" alt="accessories" />
</div>
@{
	var controller = ViewContext.RouteData.Values["controller"]?.ToString();
	var action = ViewContext.RouteData.Values["action"]?.ToString();
	var firstItem = Model.FirstOrDefault();
}

<nav class="breadcrumb-title container mb-4 small">
	<a asp-controller="Home" asp-action="Index" class="text-decoration-none text-uppercase @(controller == "Home" ? "text-warning fw-semibold" : "text-light")">
		Trang chủ
	</a>
	<span class="mx-2">/</span>
	@if (firstItem?.Category != null)
	{
		<a asp-controller="Suit" asp-action="Index" class="text-decoration-none text-uppercase @(controller == "Suit" ? "text-warning fw-semibold" : "text-light")">
			@firstItem.Category.CategoryName
		</a>
	}
</nav>
<div class="container">
	@if (!Model.Any())
	{
		<div class="alert alert-info text-center">
			Hiện chưa có sản phẩm.
		</div>
	}
	else
	{
		<div class="row mb-4">
			@foreach (var item in Model)
			{
				<div class="col-6 col-md-4 col-lg-3">
					<div class="product-box h-100">

						<a asp-controller="Home"
						   asp-action="Details"
						   asp-route-slug="@item.Slug"
						   class="text-decoration-none d-block">

							<div class="product-img">
								<img src="@item.ImageUrl"
									 alt="@item.ProductName"
									 loading="lazy">
							</div>

							<div class="product-info text-center p-2">
								<p class="m-0 small text-uppercase">
									@item.ProductName
								</p>
							</div>

						</a>

					</div>
				</div>
			}
		</div>
	}
</div>