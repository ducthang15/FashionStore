@model IEnumerable<FashionStore.Repository.Models.Product>

@{
	ViewData["Title"] = "Quản lý sản phẩm";
}
<div class="container mt-4 py-5">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h2>Quản lý Sản Phẩm</h2>
		<a asp-action="Create" class="bg-dark text-white p-2 text-decoration-none">+ Thêm sản phẩm</a>
		@if (ViewBag.CategoryFilter != null)
		{
			<a asp-area="Admin"
			   asp-controller="ProductAdmin"
			   asp-action="Sort"
			   asp-route-categoryId="@ViewBag.CategoryFilter"
			   class="btn btn-outline-dark">
				Sắp xếp kéo thả
			</a>
		}
	</div>

	<form method="get" asp-area="Admin" asp-controller="ProductAdmin"
		  asp-action="Index" class="row mb-3 g-2">

		<div class="text-dark fw-medium mb-2">Bộ lọc:</div>

		<div class="col-md-4">
			<select name="categoryId" class="form-select">
				<option value="">Tất cả danh mục</option>
				@foreach (var c in ViewBag.CategoryId)
				{
					<option value="@c.Value"
							selected="@c.Selected">
						@c.Text
					</option>
				}
			</select>
		</div>

		<div class="col-md-4">
			<input type="text"
				   name="keyword"
				   class="form-control"
				   placeholder="Tên sản phẩm..."
				   value="@ViewBag.Keyword" />
		</div>

		<div class="col-md-4">
			<button type="submit" class="btn btn-primary">
				Lọc
			</button>
			<a asp-area="Admin"
			   asp-controller="ProductAdmin"
			   asp-action="Index"
			   class="btn btn-outline-secondary">
				Xóa lọc
			</a>
		</div>
	</form>
	<form asp-action="DeleteMultiple" method="post">
		<div class="mb-3">
			<button type="submit" id="btnDeleteSelect" class="btn btn-dark">
				Xoá SP đã chọn
			</button>

			<button type="button" id="btnDeleteAll" class="btn btn-dark">
				Xoá tất cả
			</button>
		</div>
		<table class="table table-striped table-bordered align-middle">
			<thead class="table-dark">
				<tr>
					<th><input type="checkbox" id="checkAll"></th>
					<th>ID</th>
					<th>Hình ảnh</th>
					<th>Tên sản phẩm</th>
					<th>Danh mục</th>
					<th>Giá bán</th>
					<th>Tồn kho</th>
					<th>Thao tác</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in Model)
				{
					<tr>
						<td>
							<input type="checkbox" name="ids" value="@item.ProductId">
						</td>
						<td>@item.ProductId</td>
						<td><img src="@item.ImageUrl" style="width: 50px; height: 50px; object-fit: cover;"></td>
						<td class="fw-bold">@item.ProductName</td>
						<td>@item.Category.CategoryName</td>
						<td class="text-danger">@item.Price.ToString("N0") đ</td>
						<td>@item.StockQuantity</td>
						<td class="text-center">
							<a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-warning">
								<i class="fa-solid fa-pen"></i> Sửa
							</a>

							<form asp-action="Delete" asp-route-id="@item.ProductId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?');">
								<button type="submit" class="btn btn-sm btn-danger">
									<i class="fa-solid fa-trash"></i> Xóa
								</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>

		<div class="d-flex flex-wrap justify-content-between
			align-items-center gap-3 mt-4 mb-5">

			<div class="text-muted">
				Tổng: <strong>@ViewBag.TotalProducts</strong> sản phẩm
				@if ((int)ViewBag.TotalPages > 0)
				{
					<span>
						— Trang @ViewBag.CurrentPage /
						@ViewBag.TotalPages
					</span>
				}
			</div>

			@if ((int)ViewBag.TotalPages > 1)
			{
				<nav aria-label="Phân trang sản phẩm">
					<ul class="pagination mb-0">

						<li class="page-item
							@(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
							<a class="page-link"
							   asp-area="Admin"
							   asp-controller="ProductAdmin"
							   asp-action="Index"
							   asp-route-page="@(ViewBag.CurrentPage - 1)"
							   asp-route-categoryId="@ViewBag.CategoryFilter"
							   asp-route-keyword="@ViewBag.Keyword">
								Trước
							</a>
						</li>

						@for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
						{
							<li class="page-item
								@(i == (int)ViewBag.CurrentPage ? "active" : "")">
								<a class="page-link"
								   asp-area="Admin"
								   asp-controller="ProductAdmin"
								   asp-action="Index"
								   asp-route-page="@i"
								   asp-route-categoryId="@ViewBag.CategoryFilter"
								   asp-route-keyword="@ViewBag.Keyword">
									@i
								</a>
							</li>
						}

						<li class="page-item
							@(ViewBag.CurrentPage >= ViewBag.TotalPages
								? "disabled" : "")">
							<a class="page-link"
							   asp-area="Admin"
							   asp-controller="ProductAdmin"
							   asp-action="Index"
							   asp-route-page="@(ViewBag.CurrentPage + 1)"
							   asp-route-categoryId="@ViewBag.CategoryFilter"
							   asp-route-keyword="@ViewBag.Keyword">
								Sau
							</a>
						</li>

					</ul>
				</nav>
			}
		</div>

	</form>
</div>
