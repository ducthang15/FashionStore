@model FashionStore.Repository.Models.Product

@{
	ViewData["Title"] = "Thêm sản phẩm mới";
}

<div class="container mt-3">
	<h2 class="mb-4">Thêm Sản Phẩm Mới</h2>
	<form asp-action="Create" method="post" enctype="multipart/form-data" class="shadow p-4 bg-light rounded">
		<div asp-validation-summary="All" class="text-danger"></div>
		<div class="mb-3">
			<label asp-for="ProductName" class="form-label fw-bold">Tên sản phẩm</label>
			<input asp-for="ProductName" class="form-control" required />
		</div>

		<div class="row">
			<div class="mb-3 col-md-4">
				<label asp-for="Price" class="form-label fw-bold">Giá bán</label>
				<input asp-for="Price" type="number" class="form-control" required />
			</div>
			<div class="mb-3 col-md-4">
				<label asp-for="StockQuantity" class="form-label fw-bold">Tồn kho</label>
				<input asp-for="StockQuantity" type="number" class="form-control" required />
			</div>
			<div class="col-md-4 mb-3">
				<label class="form-label fw-bold">Danh mục</label>
				<select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
					<option value="">-- Chọn danh mục --</option>
				</select>
			</div>
		</div>

		<div class="mb-3">
			<label class="form-label fw-bold">Chọn hình ảnh (Có thể chọn nhiều)</label>
			<input type="file" name="files" class="form-control" multiple accept="image/*" />
			<input type="hidden" name="mainImageIndex" id="mainImageIndex" value="0" />
			<div id="previewContainer" class="d-flex flex-wrap mt-3 gap-2"></div>
		</div>

		<div class="mb-3">
			<label asp-for="Description" class="form-label fw-bold" id="Content">Mô tả</label>
			<textarea asp-for="Description" class="form-control" rows="10"></textarea>
		</div>
		<div class="mb-3">
			<button type="submit" class="btn btn-primary float-end">LƯU SẢN PHẨM</button>
			<a asp-action="Index" class="btn btn-secondary">Hủy</a>
		</div>
	</form>
</div>
<script src="https://cdn.tiny.cloud/1/gg9075l09p561nfyr6m1gyxv5n46i1jy70xgcrj4qgi98ils/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
<script>
	   tinymce.init({
		selector: 'textarea[name="Description"]',
		height: 400
	});
</script>
@section Scripts {
	<script src="~/js/addproduct.js"></script>

}