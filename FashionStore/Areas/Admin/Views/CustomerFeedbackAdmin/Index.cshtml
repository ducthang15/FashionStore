@model IEnumerable<FashionStore.Repository.Models.CustomerFeedback>

@{
    ViewData["Title"] = "Quản lý Ảnh Khách Hàng";
}

<div class="card shadow border-0 mt-3">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-0 fw-bold text-dark"> Lookbook khách hàng</h4>
        </div>
        <a asp-action="Create" class="btn btn-dark rounded-pill px-4">
            <i class="fa-solid fa-cloud-arrow-up me-2"></i> Đăng ảnh mới
        </a>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Hình ảnh</th>
                        <th>Nội dung / Tags</th>
                        <th>Ngày đăng</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fa-regular fa-image fa-3x mb-3"></i>
                                <p>Chưa có ảnh feedback nào.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    @if (item.FeedbackImages != null && item.FeedbackImages.Any())
                                    {
                                        var firstImage = item.FeedbackImages.FirstOrDefault()?.ImageUrl;
                                        <img src="@firstImage" class="rounded shadow-sm border"
                                             style="width: 100px; height: 100px; object-fit: cover;"
                                             onerror="this.onerror=null;this.src='/images/no-image.png'">
                                    }
                                    else
                                    {
                                        <img src="/images/no-image.png"
                                             class="rounded shadow-sm border"
                                             style="width: 100px; height: 100px; object-fit: cover;">
                                    }
                                </td>

                                <td style="max-width: 350px;">
                                    @if (!string.IsNullOrEmpty(item.CustomerName))
                                    {
                                        <div class="fw-bold text-dark">@item.CustomerName</div>
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-muted fst-italic">Khách ẩn danh</div>
                                    }

                                    <div class="text-secondary small mt-1">@item.Content</div>

                                    @if (!string.IsNullOrEmpty(item.Tags))
                                    {
                                        <div class="mt-2">
                                            @foreach (var tag in item.Tags.Split(','))
                                            {
                                                <span class="badge bg-light text-dark border me-1">#@tag.Trim()</span>
                                            }
                                        </div>
                                    }
                                </td>

                                <td>
                                    <div class="small fw-bold">@item.CreatedAt?.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted small">@item.CreatedAt?.ToString("HH:mm")</div>
                                </td>

                                <td class="text-end pe-4">
                                    <form asp-action="Delete" asp-route-id="@item.FeedbackId" method="post" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa ảnh này không?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa ảnh">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>